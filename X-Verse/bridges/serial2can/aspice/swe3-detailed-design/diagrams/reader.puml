@startuml reader
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
title DD-06/07/08 SerialLink reader thread
start
while (not stopping?) is (yes)
  :_open(): resolve glob → path;
  if (path found and Serial() opens?) then (yes)
    partition "_serve(port)" {
      :_handshake(): flush, C, V, S<n>, O;
      if (O acknowledged?) then (yes)
        :connected.set(); established = true; connects++;
        :handle pending tokens\n(state frame after O);
        repeat
          :tokens = splitter.feed(read());
          :_handle(token) for each:\nframe → decode → from_serial filter → bridge.from_serial\nz/Z → acks++ · BELL → nacks++ · None → malformed++;
        repeat while (no I/O error and not stopping?)
      else (no)
        :raise SerialException;
      endif
    }
    partition "_end_session(port, established)" {
      if (stopping?) then (no)
        :disconnects++ if established;
        :connected.clear(); port.close();
      else (yes)
        :keep port for close() → "C";
      endif
      :drain queue (dropped_offline);
    }
  else (no)
    :log warning (open failed);
  endif
  :wait reconnect_s;
endwhile (no)
stop
@enduml
