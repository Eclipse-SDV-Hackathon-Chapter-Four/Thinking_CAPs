@startuml components
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
title Static view — modules, classes and interfaces
skinparam classAttributeIconSize 0
set separator none
hide empty members
package "src/slcan.py — ARC-01" #F7F7F2 {
  class "encode(message) → bytes" as ENC
  class "decode(line) → can.Message" as DEC
  class LineSplitter {
    +feed(data) → list[token]
  }
  class SlcanError
}
package "src/serial2can_bridge.py" #F4F8FC {
  class "IdFilter — ARC-02" as IdFilter {
    +matches(message) → bool
  }
  class "EchoGuard — ARC-03" as EchoGuard {
    +sent(message)
    +is_echo(message) → bool
  }
  class "SerialLink — ARC-04/ARC-05" as SerialLink {
    +connected : Event
    +stats : dict
    +start() / close()
    +enqueue(message)
    -_read_loop() / _open() / _serve()
    -_handshake() / _command() / _handle()
    -_write_loop()
  }
  class "Serial2CanBridge — ARC-06" as Bridge {
    +bus : can.BusABC
    +from_serial(source, message)
    +run() / shutdown()
    -_dispatch(message)
  }
  class "load_config() / main() — ARC-07" as CLI
}
class "launch/bridge_launch.py — ARC-08" as Launch
package "Third party" #F2F7F2 {
  class "python-can Bus" as PC
  class "pyserial Serial" as PS
}
Bridge "1" *-- "1..n" SerialLink
Bridge --> EchoGuard
Bridge --> PC : IF-02 send / recv
SerialLink --> IdFilter : to_serial / from_serial
SerialLink --> LineSplitter
SerialLink --> DEC
SerialLink --> ENC
SerialLink --> PS : IF-01 SLCAN
SerialLink --> Bridge : IF-05 from_serial()
Bridge --> SerialLink : IF-06 enqueue()
CLI --> Bridge : IF-03 config, IF-04 signals
Launch --> CLI : subprocess
@enduml
