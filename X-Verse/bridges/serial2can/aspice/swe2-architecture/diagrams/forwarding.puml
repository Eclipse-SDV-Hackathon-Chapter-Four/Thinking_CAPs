@startuml forwarding
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
title Sequence — forwarding with filters, fan-out and echo suppression
participant "ECU A" as A
participant "SerialLink A" as LA
participant "Serial2CanBridge" as B
participant "EchoGuard" as G
participant "CAN bus\n(udp_multicast)" as BUS
participant "SerialLink B" as LB
participant "Zenoh2CAN" as Z
A -> LA : "t1F4803…"
LA -> LA : decode + from_serial filter
LA -> B : from_serial(A, msg)
B -> G : sent(msg)
B -> BUS : send(msg)
B -> LB : enqueue(msg) (fan-out, not to A)
BUS --> Z : 0x1F4
BUS --> B : 0x1F4 (loop-back)
B -> G : is_echo → true, dropped
Z -> BUS : 0x1F1 status
BUS --> B : 0x1F1
B -> LA : enqueue → to_serial accepts
B -> LB : enqueue → filtered_out
LA -> A : "t1F1806…" (tx thread)
A --> LA : z
@enduml
