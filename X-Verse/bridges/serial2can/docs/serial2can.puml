@startuml serial2can
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
title X-COM Serial2CAN bridge
left to right direction

node "Serial ECUs" {
  component "AZ3166\nThreadX zonal ECU" as A
  component "S32K148\nOpenBSW ECU (planned)" as B
}
package "Serial2CAN bridge (Python)" as BR #F4F8FC {
  component "SerialLink\nper port: handshake C/V/Sn/O,\nreconnect, rx/tx threads,\nID filters, bounded TX queue" as L
  component "Fan-out\nserial → CAN + other ports" as F
  component "EchoGuard\n(udp_multicast loopback)" as E
  component "CAN RX loop\nCAN → ports by to_serial" as R
}
queue "X-Verse CAN bus\nSocketCAN vcan0 | udp_multicast" as BUS
component "Zenoh2CAN bridge\n(unchanged)" as Z
component "Zenoh / X-Verse\nVCU, vehicle, CARLA" as X
component "candump, test tools" as T

A <--> L : SLCAN over USB UART
B <--> L : SLCAN over USB UART
L --> F
F --> BUS
F --> L
BUS --> R
R --> E
R --> L
BUS <--> Z
Z <--> X
BUS <--> T
@enduml
