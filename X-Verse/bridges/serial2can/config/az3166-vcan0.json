{
  "can": {
    "interface": "socketcan",
    "channel": "vcan0"
  },
  "serial_ports": [
    {
      "name": "az3166-threadx-zonal",
      "device": "/dev/serial/by-id/usb-STMicroelectronics_STM32_STLink_*-if02",
      "baudrate": 115200,
      "can_bitrate": 500000,
      "to_serial": [{ "id": "0x1F1", "mask": "0x7FF", "extended": false }],
      "from_serial": [{ "id": "0x1F4", "mask": "0x7FE", "extended": false }],
      "tx_queue": 256,
      "reconnect_s": 2.0
    }
  ],
  "stats_interval_s": 30
}
