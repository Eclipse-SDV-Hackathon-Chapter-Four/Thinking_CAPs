{
  "can": {
    "interface": "socketcan",
    "channel": "vcan0"
  },
  "serial_ports": [
    {
      "name": "az3166-threadx-zonal",
      "device": "/dev/serial/by-id/usb-STMicroelectronics_STM32_STLink_*-if02",
      "to_serial": [{ "id": "0x1F1" }],
      "from_serial": [{ "id": "0x1F4", "mask": "0x7FE" }]
    },
    {
      "name": "s32k148-openbsw",
      "device": "/dev/serial/by-id/usb-P_E_Microcomputer_Systems_Inc._OpenSDA_Hardware_*-if00",
      "baudrate": 115200,
      "to_serial": [{ "id": "0x100", "mask": "0x700" }],
      "from_serial": [{ "id": "0x200", "mask": "0x700" }]
    }
  ],
  "stats_interval_s": 30
}
