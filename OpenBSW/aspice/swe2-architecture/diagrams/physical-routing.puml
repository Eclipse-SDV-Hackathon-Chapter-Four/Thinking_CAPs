@startuml physical-routing
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
title Dynamic view — physical request to the ThreadX rear lighting ECU (0x1020)
autonumber

actor "SOVD client" as U
participant "OpenSOVD\n+ CDA" as CDA
participant "DoIpServerSystem\nARC-01" as DoIp
participant "TransportRouter\nARC-03" as R
participant "RoutingTable\nARC-04" as T
participant "DoCanSystem\nARC-02" as Tp
participant "ThreadX rear\nlighting ECU" as ECU
participant "NodeMonitor\nARC-06" as M

== Discovery and routing activation (once per connection) ==
DoIp -> CDA : vehicle announcement ×3 (UDP 13400)\nVIN, 0x1010, EID, GID
CDA -> DoIp : TCP connect, routing activation\nsource 0x0E80, type 0x00
DoIp --> CDA : routing activation response 0x10

== Physical request ==
U -> CDA : GET /components/rear_lighting/data/sw_version
CDA -> DoIp : diag msg 0x0E80 → 0x1020\n22 F1 95
DoIp -> R : getTransportMessage / messageReceived
R -> T : find(0x1020)
T --> R : docan route 0x7E1 / 0x7E9, P2 150 ms
alt route has a pending request or no buffer is free
  R --> DoIp : rejected
  DoIp --> CDA : NACK 0x05 (SWR-015)
else route free
  R -> Tp : send on 0x7E1 (source 0x0E10)
  R --> DoIp : accepted
  DoIp --> CDA : ACK 0x8002 (SWR-003)
  Tp -> ECU : SF 03 22 F1 95 (padded 0xCC)
  Tp --> R : processed OK → P2 starts
  opt ECU needs more time
    ECU -> Tp : 7F 22 78
    Tp -> R : messageReceived(0x7E9)
    R -> DoIp : forward unchanged (SWR-014)
    DoIp -> CDA : diag msg 0x1020 → 0x0E80\n7F 22 78
    R -> R : restart with P2* (5100 ms)
  end
  alt response within P2 / P2*
    ECU -> Tp : FF/CF 62 F1 95 ... (flow control from gateway)
    Tp -> R : messageReceived(0x7E9)
    R -> DoIp : forward to tester 0x0E80
    DoIp -> CDA : diag msg 0x1020 → 0x0E80\n62 F1 95 ...
    R -> M : routeResponded(0)
    CDA --> U : 200 {"sw_version": ...}
  else timeout
    R -> R : release pending, count timeout (SWR-016)
    R -> M : routeTimedOut(0)
    note right of M : 3 consecutive → U0140 testFailed\n(SWR-024)
    CDA --> U : error (CDA's own timeout)
  end
end
@enduml
