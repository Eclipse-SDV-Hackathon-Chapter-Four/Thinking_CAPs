+
+        let paths = load_mdd_paths_from_storage(&fixture.storage)
+            .await
+            .expect("empty collection is not an error");
+
+        assert!(paths.is_empty());
+    }
+
+    #[tokio::test]
+    async fn resolve_mdd_paths_falls_back_when_storage_unavailable() {
+        let fixture = Fixture::new_with_mdd_files(&[("ECU.mdd", b"DATA")]);
+        break_storage(&fixture);
+
+        let paths =
