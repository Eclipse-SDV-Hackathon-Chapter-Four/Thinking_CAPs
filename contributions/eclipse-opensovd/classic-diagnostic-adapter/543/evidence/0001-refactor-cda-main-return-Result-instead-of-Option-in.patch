+    /// Replaces the storage's `collections` directory with a plain file, so every
+    /// collection access fails (also when the tests run as root).
+    fn break_storage(fixture: &Fixture) {
+        let collections = fixture.storage_dir.path().join("collections");
+        std::fs::remove_dir_all(&collections).expect("remove collections dir");
+        std::fs::write(&collections, b"not a directory").expect("replace with file");
+    }
+
+    #[tokio::test]
+    async fn load_mdd_paths_from_storage_reports_unavailable_storage() {
+        let fixture = Fixture::new_with_mdd_files(&[("ECU.mdd", b"DATA")]);
+        break_storage(&fixture);
+
+        let result = load_mdd_paths_from_storage(&fixture.storage).await;
+
+        assert!(
+            matches!(result, Err(MddLoadingError::StorageUnavailable { .. })),
+            "Expected StorageUnavailable, got {result:?}"
+        );
+    }
+
+    #[tokio::test]
+    async fn load_mdd_paths_from_storage_returns_empty_for_empty_collection() {
