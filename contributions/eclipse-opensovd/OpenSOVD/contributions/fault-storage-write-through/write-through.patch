+    /// Helper executed in separate OS processes so the global KVS pool cannot
+    /// masquerade as disk persistence. No environment means an ordinary no-op test.
+    #[test]
+    fn write_through_process_child() {
+        use super::{KvsSovdFaultStateStorage, StorageError};
+        let Ok(mode) = std::env::var("SDV_STORAGE_TEST_MODE") else {
+            return;
+        };
+        let directory = std::path::PathBuf::from(std::env::var("SDV_STORAGE_TEST_PATH").unwrap());
+        std::fs::create_dir_all(&directory).unwrap();
+        let storage = KvsSovdFaultStateStorage::new_write_through(&directory, 0).unwrap();
+        let id = FaultId::Numeric(42);
+        let other = FaultId::Numeric(43);
+        match mode.as_str() {
+            "write" => {
+                let state = SovdFaultState {
+                    test_failed: true,
+                    confirmed_dtc: true,
+                    occurrence_counter: 3,
+                    env_data: [("source".into(), "actual-receiver".into())].into(),
+                    ..Default::default()
+                };
+                storage.put("cruise_control", &id, state).unwrap();
+                storage
+                    .put("cruise_control", &other, SovdFaultState::default())
+                    .unwrap();
+            }
+            "read" => {
+                let state = storage.get("cruise_control", &id).unwrap().unwrap();
+                assert!(state.test_failed);
+                assert!(state.confirmed_dtc);
+                assert_eq!(state.occurrence_counter, 3);
+                assert_eq!(
+                    state.env_data.get("source").map(String::as_str),
+                    Some("actual-receiver")
+                );
+                assert!(storage.get("cruise_control", &other).unwrap().is_some());
+            }
+            "delete" => storage.delete("cruise_control", &id).unwrap(),
+            "verify-delete" => {
+                assert!(storage.get("cruise_control", &id).unwrap().is_none());
+                assert!(storage.get("cruise_control", &other).unwrap().is_some());
+            }
+            "clear" => storage.delete_all("cruise_control").unwrap(),
+            "verify-clear" => assert!(storage.get_all("cruise_control").unwrap().is_empty()),
+            "corrupt-map" => {
+                use rust_kvs::prelude::KvsApi;
+                storage
+                    .kvs
+                    .lock()
+                    .unwrap()
+                    .set_value("cruise_control", "invalid-map")
+                    .unwrap();
+                assert!(storage.get("cruise_control", &id).is_err());
+                assert!(storage.get_all("cruise_control").is_err());
+                assert!(
+                    storage
+                        .put("cruise_control", &id, SovdFaultState::default())
+                        .is_err()
+                );
+            }
+            "flush-error" => {
+                let moved = directory.with_extension("moved");
+                std::fs::rename(&directory, moved).unwrap();
+                std::fs::write(&directory, b"blocks backend directory").unwrap();
+                assert!(matches!(
+                    storage.put("cruise_control", &id, SovdFaultState::default()),
+                    Err(StorageError::Backend(_))
+                ));
+            }
+            _ => panic!("unknown child mode"),
+        }
+    }
+
+    /// Put, delete and clear must survive complete OS-process replacement.
+    #[test]
+    fn durable_state_survives_real_process_restart() {
+        let directory = tempfile::tempdir().unwrap();
+        for mode in [
+            "write",
+            "read",
+            "delete",
+            "verify-delete",
+            "clear",
+            "verify-clear",
+        ] {
+            let output = std::process::Command::new(std::env::current_exe().unwrap())
+                .args([
+                    "--exact",
+                    "sovd_fault_storage::storage_tests::write_through_process_child",
+                    "--nocapture",
+                ])
+                .env("SDV_STORAGE_TEST_MODE", mode)
+                .env("SDV_STORAGE_TEST_PATH", directory.path().join("data"))
+                .output()
+                .unwrap();
+            assert!(
+                output.status.success(),
+                "child {mode}: {} {}",
+                String::from_utf8_lossy(&output.stdout),
+                String::from_utf8_lossy(&output.stderr)
+            );
+        }
+    }
+
