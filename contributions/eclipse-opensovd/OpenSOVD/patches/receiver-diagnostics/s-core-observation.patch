diff --git a/cc_s-core/score/cruise_control/src/diagnostic_publisher.h b/cc_s-core/score/cruise_control/src/diagnostic_publisher.h
new file mode 100644
index 0000000..d1a4d0a
--- /dev/null
+++ b/cc_s-core/score/cruise_control/src/diagnostic_publisher.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef SDV_DIAGNOSTIC_PUBLISHER_H
+#define SDV_DIAGNOSTIC_PUBLISHER_H
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <string>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace sdv_diagnostics {
+inline std::uint64_t MonotonicNs() {
+    timespec time{};
+    if (clock_gettime(CLOCK_MONOTONIC, &time) != 0) return 0;
+    return static_cast<std::uint64_t>(time.tv_sec) * 1000000000ULL +
+           static_cast<std::uint64_t>(time.tv_nsec);
+}
+inline std::string Quote(const std::string& value) {
+    std::string out = "\"";
+    for (unsigned char character : value) {
+        if (character == '"' || character == '\\') out += '\\';
+        if (character < 32) { out += '?'; } else { out += static_cast<char>(character); }
+    }
+    return out + "\"";
+}
+inline std::string Stamp(std::uint64_t value) { return value ? std::to_string(value) : "null"; }
+inline std::string Number(double value) { return std::isfinite(value) ? std::to_string(value) : "null"; }
+
+class Publisher {
+public:
+    Publisher() {
+        const char* path = std::getenv("SCORE_DIAGNOSTIC_SOCKET");
+        if (!path || !*path || std::char_traits<char>::length(path) >= sizeof(address_.sun_path)) return;
+        address_.sun_family = AF_UNIX;
+        std::copy(path, path + std::char_traits<char>::length(path), address_.sun_path);
+        fd_ = socket(AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+        std::ifstream boot("/proc/sys/kernel/random/boot_id"); std::getline(boot, boot_id_);
+        session_ = std::to_string(getpid()) + ":" + std::to_string(MonotonicNs());
+        const char* identity = std::getenv("SCORE_BUILD_IDENTITY");
+        identity_ = identity && *identity ? std::string(identity).substr(0, 1024) : "unknown";
+    }
+    ~Publisher() { if (fd_ >= 0) close(fd_); }
+    Publisher(const Publisher&) = delete;
+    Publisher& operator=(const Publisher&) = delete;
+    void Send(const std::string& bytes) noexcept {
+        if (fd_ < 0 || bytes.size() > 4096) return;
+        (void)sendto(fd_, bytes.data(), bytes.size(), MSG_DONTWAIT | MSG_NOSIGNAL,
+                     reinterpret_cast<const sockaddr*>(&address_), sizeof(address_));
+    }
+    void Emit(std::uint64_t received, std::uint64_t accepted, double speed,
+              double target, bool engaged) noexcept {
+        if (fd_ < 0) return;
+        try {
+        Send("{\"schema_version\":1,\"source_instance\":\"cruise-control\",\"source_session\":" + Quote(session_) +
+             ",\"boot_id\":" + Quote(boot_id_) + ",\"clock_domain\":\"linux-clock-monotonic\"," +
+             "\"observed_at_monotonic_ns\":" + std::to_string(MonotonicNs()) +
+             ",\"received_at_monotonic_ns\":" + Stamp(received) +
+             ",\"last_accepted_at_monotonic_ns\":" + Stamp(accepted) +
+             ",\"vehicle_speed\":" + (accepted ? Number(speed) : "null") +
+             ",\"target_speed\":" + Number(target) +
+             ",\"cc_state\":" + Quote(engaged ? "engaged" : "disengaged") +
+             ",\"software_identity\":" + Quote(identity_) +
+             ",\"sample_id\":null,\"integrity_result\":\"not_available\",\"acceptance_kind\":\"decoded_by_consumer\"}");
+        } catch (...) { /* Observation failure must not terminate the control loop. */ }
+    }
+private:
+    int fd_{-1};
+    sockaddr_un address_{};
+    std::string boot_id_, session_, identity_;
+};
+} // namespace sdv_diagnostics
+#endif
