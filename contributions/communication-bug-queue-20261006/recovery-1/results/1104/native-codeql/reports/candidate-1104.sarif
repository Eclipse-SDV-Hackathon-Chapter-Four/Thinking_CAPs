                "id": "cpp/misra/non-static-member-not-init-before-use",
                "kind": "problem",
                "name": "RULE-15-1-4: All direct, non-static data members of a class should be initialized before the class object is accessible",
                "precision": "high",
                "problem.severity": "warning"
              }
            },
