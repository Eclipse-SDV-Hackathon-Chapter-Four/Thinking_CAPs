@startuml
title S-CORE (OS) to OpenSOVD Data Flow - Read Operation

skinparam participant {
    BackgroundColor<<score>> #E8F5E9
    BackgroundColor<<opensovd>> #E3F2FD
    BackgroundColor<<adapter>> #FFF3E0
    BackgroundColor<<app>> #FCE4EC
}

actor "REST Client\n(Dashboard)" as Client

box "OpenSOVD (SOVD Protocol)" #E3F2FD
    participant "opensovd-server" as Server <<opensovd>>
    participant "opensovd-core\n(DataProvider trait)" as Core <<opensovd>>
end box

box "sovd_adapter (Bridge Layer)" #FFF3E0
    participant "SovdDataProvider" as Provider <<adapter>>
    participant "DataResourceRegistry" as Registry <<adapter>>
    participant "convert" as Conv <<adapter>>
    participant "handle" as Handle <<adapter>>
end box

box "Application (Cruise Control ECU)" #FCE4EC
    participant "CruiseDiag" as Cruise <<app>>
end box

box "S-CORE (Operating System)" #E8F5E9
    participant "diag_api\n(DataResource)" as Resource <<score>>
    participant "Middleware\nServices" as MW <<score>>
    participant "Hardware\nAbstraction" as HAL <<score>>
end box

== Initialization (ECU Startup on S-CORE OS) ==

note over HAL, MW
    S-CORE OS provides:
    - Diagnostic middleware (diag_api)
    - Communication stack (SOME/IP, DoIP)
    - Hardware abstraction layer
end note

Cruise -> Resource : implements DataResource trait
Cruise -> Registry : register(metadata, resource)
Registry -> Registry : Store in IndexMap
Provider -> Registry : new(registry)
Server -> Provider : set_data_provider(provider)

== Runtime: Read vehicle_speed ==

Client -> Server : GET /sovd/v1/components/cruise/data/vehicle_speed
Server -> Core : DataProvider::read("vehicle_speed", false)
Core -> Provider : read("vehicle_speed", include_schema=false)

Provider -> Registry : get("vehicle_speed")
Registry --> Provider : Entry { metadata, format, resource }

Provider -> Provider : Check read-only (allow)

group S-CORE diag_api Call
    Provider -> Resource : read(args)
    note right of Resource
        S-CORE diag_api interface
        Provides diagnostic data access
    end note
    Resource -> MW : Get sensor data
    MW -> HAL : Read speed sensor
    HAL --> MW : Raw sensor value
    MW --> Resource : Processed: 99.8 km/h
    Resource --> Provider : ReadValueHandle::Ready(payload)
end

alt ReadValueHandle::Ready
    Provider -> Handle : resolve_read(Ready(result))
    Handle --> Provider : ReadValueReply { payload }
else ReadValueHandle::Pending(Future)
    Provider -> Handle : resolve_read(Pending(future))
    Handle -> Handle : future.await
    Handle --> Provider : ReadValueReply { payload }
end

Provider -> Conv : reply_value(payload, format)
note right of Conv
    S-CORE serde_json::Value
    → OpenSOVD serde_json::Value
end note
Conv --> Provider : (Value, Option<Schema>)

Provider --> Core : DataReply::Data { data, schema }
Core --> Server : DataReply
Server --> Client : 200 OK\n{ "value": 99.8, "unit": "km/h" }

== Fault Injection: Write to speed_sensor_stuck ==

Client -> Server : PUT /sovd/v1/components/cruise/data/speed_sensor_stuck\n{ "stuck": true }
Server -> Core : DataProvider::write("speed_sensor_stuck", value)
Core -> Provider : write("speed_sensor_stuck", value)

Provider -> Registry : get("speed_sensor_stuck")
Registry --> Provider : Entry { metadata: { read_only: false }, ... }
Provider -> Provider : Check read-only (allow write)

Provider -> Conv : request_payload(value)
Conv --> Provider : RequestMessagePayload

group S-CORE diag_api Call
    Provider -> Resource : write(payload)
    Resource -> MW : Inject fault condition
    MW -> HAL : Simulate stuck sensor
    HAL --> MW : Acknowledged
    MW --> Resource : Ok
    Resource --> Provider : WriteValueHandle::Ready(Ok)
end

Provider --> Core : DataReply::Written
Core --> Server : DataReply
Server --> Client : 200 OK

@enduml
