@startuml buffer-ownership
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
title DD-01/DD-03 — buffer ownership on a routed request
autonumber

participant "DoIP server" as DoIp
participant "TransportRouter" as R
participant "RouteContext[i]" as C
participant "DoCAN layer" as Tp

== request ==
DoIp -> R : getTransportMessage(ETH, 0x0E80, 0x1020, n)
R --> DoIp : buffer A (route i RESERVED)
DoIp -> R : messageReceived(ETH, A, doipListener)
R -> R : A.source := 0x0E10; route i SENDING
R -> Tp : send(A, &RouteContext[i])
R --> DoIp : RECEIVED_NO_ERROR → ACK
Tp -> C : transportMessageProcessed(A, OK)
C -> R : routeProcessed → WAIT_RESPONSE, P2
C -> C : A.source := 0x0E80
C -> DoIp : transportMessageProcessed(A, OK)
DoIp -> R : releaseTransportMessage(A)

== response ==
Tp -> R : getTransportMessage(CAN, 0x1020, 0x0E10, m)
R --> Tp : buffer B
Tp -> R : messageReceived(CAN, B, docanListener)
R -> R : B.target := 0x0E80; route i IDLE;\nobserver.routeResponded(i)
R -> DoIp : send(B, docanListener)
DoIp -> Tp : transportMessageProcessed(B, OK) (after TCP send)
Tp -> R : releaseTransportMessage(B)
@enduml
