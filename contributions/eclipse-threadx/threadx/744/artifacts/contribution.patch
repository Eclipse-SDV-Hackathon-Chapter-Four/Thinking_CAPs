+    check(next == _tx_thread_created_ptr, "created list closes");
+    check((interrupt_depth == 0U) && (interrupt_errors == 0U), "balanced interrupt posture");
+    check(preempt_calls == index + 1U, "preemption check count");
+    check(unexpected_calls == 0U, "no scheduling at recorder boundary");
+}
+
+/* Native64 is a required precondition, never a successful no-op test. */
+INT main(VOID)
+{
+UINT offset;
+UINT tail;
+UINT index =  0U;
+
+    printf("sizeof(ULONG)=%zu sizeof(ALIGN_TYPE)=%zu sizeof(void*)=%zu\n",
+           sizeof(ULONG), sizeof(ALIGN_TYPE), sizeof(VOID *));
+    if ((sizeof(ULONG) != 4U) || (sizeof(ALIGN_TYPE) != 8U) || (sizeof(VOID *) != 8U) ||
+        ((ALIGN_TYPE) storage <= (ALIGN_TYPE) ((ULONG) ~0U)))
+    {
+        puts("FAIL: native64 high-address preconditions absent");
+        return(1);
+    }
+    for (offset = 0U; offset < sizeof(ULONG); offset++)
+    {
+        for (tail = 0U; tail < sizeof(ULONG); tail++)
+        {
+            run_case(offset, STACK_BYTES + tail, index++);
+        }
+    }
+    printf("%s: %u alignment/size cases, %u failures\n", (failures == 0U) ? "PASS" : "FAIL",
+           index, failures);
+    return((failures == 0U) ? 0 : 1);
+}
