+score::mw::com::impl::SizeInfo ffi_get_method_in_arg_ptr_user_defined_type_size() noexcept
+{
+    return score::mw::com::impl::TestSizeProvider::GetMethodInArgPtrUserDefinedTypeSize();
+}
+
 }  // extern "C"
