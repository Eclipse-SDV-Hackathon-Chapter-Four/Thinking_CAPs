[{"sha":"fb8079c65b73f45debd4a37e29a10db7de36dfc7","node_id":"C_kwDOU-hG19oAKGZiODA3OWM2NWI3M2Y0NWRlYmQ0YTM3ZTI5YTEwZGI3ZGUzNmRmYzc","commit":{"author":{"name":"erupuri","email":"erupuripurushotham1@gmail.com","date":"2026-10-06T18:25:32Z"},"committer":{"name":"erupuri","email":"erupuripurushotham1@gmail.com","date":"2026-10-06T18:25:32Z"},"message":"refactor(cda-main): return Result instead of Option in mdd.rs\n\n  Replace Option<T> with Result<T, MddLoadingError> for proper error\n  handling in build_diagnostic_database, create_ecu_manager, and\n  load_ecu_from_file functions.\n\n  Add new error variants to MddLoadingError:\n  - MissingPayload: when diagnostic description payload is not found\n  - DatabaseBuildFailed: when database creation from payload fails\n  - ComParamsInvalid: when per-ECU com_params cannot be resolved\n  - EcuManagerFailed: when ECU manager creation fails\n\n  Add unit test for the MissingPayload error path.\n\n  Closes #543\n\n  Contributed by: EP1991 | Thinking_CAPs | Eclipse SDV Hackathon Chapter 4 2026","tree":{"sha":"940cab3437a85d80752fee2efa8315d068539dbd","url":"https://api.github.com/repos/eclipse-opensovd/classic-diagnostic-adapter/git/trees/940cab3437a85d80752fee2efa8315d068539dbd"},"url":"https://api.github.com/repos/eclipse-opensovd/classic-diagnostic-adapter/git/commits/fb8079c65b73f45debd4a37e29a10db7de36dfc7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/eclipse-opensovd/classic-diagnostic-adapter/commits/fb8079c65b73f45debd4a37e29a10db7de36dfc7","html_url":"https://github.com/eclipse-opensovd/classic-diagnostic-adapter/commit/fb8079c65b73f45debd4a37e29a10db7de36dfc7","comments_url":"https://api.github.com/repos/eclipse-opensovd/classic-diagnostic-adapter/commits/fb8079c65b73f45debd4a37e29a10db7de36dfc7/comments","author":{"login":"erupuri","id":241647247,"node_id":"U_kgDODmc-jw","avatar_url":"https://avatars.gith