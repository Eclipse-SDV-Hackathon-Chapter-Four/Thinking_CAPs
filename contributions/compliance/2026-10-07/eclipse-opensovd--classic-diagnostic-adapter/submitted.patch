From fb8079c65b73f45debd4a37e29a10db7de36dfc7 Mon Sep 17 00:00:00 2001
From: erupuri <erupuripurushotham1@gmail.com>
Date: Tue, 6 Oct 2026 20:25:32 +0200
Subject: [PATCH] refactor(cda-main): return Result instead of Option in mdd.rs

  Replace Option<T> with Result<T, MddLoadingError> for proper error
  handling in build_diagnostic_database, create_ecu_manager, and
  load_ecu_from_file functions.

  Add new error variants to MddLoadingError:
  - MissingPayload: when diagnostic description payload is not found
  - DatabaseBuildFailed: when database creation from payload fails
  - ComParamsInvalid: when per-ECU com_params cannot be resolved
  - EcuManagerFailed: when ECU manager creation fails

  Add unit test for the MissingPayload error path.

  Closes #543

  Contributed by: EP1991 | Thinking_CAPs | Eclipse SDV Hackathon Chapter 4 2026
---
 cda-main/src/mdd.rs | 120 ++++++++++++++++++++++++++++++--------------
 1 file changed, 83 insertions(+), 37 deletions(-)

diff --git a/cda-main/src/mdd.rs b/cda-main/src/mdd.rs
index e2b48e694..f45c00420 100644
--- a/cda-main/src/mdd.rs
+++ b/cda-main/src/mdd.rs
@@ -48,6 +48,18 @@ pub enum MddLoadingError {
     LoadFailed { path: String, reason: String },
     #[error("Failed to decompress MDD {path}: {reason}")]
     DecompressFailed { path: String, reason: String },
+    #[error("No diagnostic description payload for ECU {ecu} in MDD {path}")]
+    MissingPayload { path: String, ecu: String },
+    #[error("Failed to create database for ECU {ecu} from MDD {path}: {reason}")]
+    DatabaseBuildFailed {
+        path: String,
+        ecu: String,
+        reason: String,
+    },
+    #[error("Invalid per-ECU com_params for ECU {ecu}")]
+    ComParamsInvalid { ecu: String },
+    #[error("Failed to create ECU manager for ECU {ecu}: {reason}")]
+    EcuManagerFailed { ecu: String, reason: String },
 }
 
 pub const PROTO_LOAD_CONFIG: &[ProtoLoadConfig; 4] = &[
@@ -368,23 +380,23 @@ async fn mark_duplicate_ecus_by_address<S: SecurityPlugin>(
 }
 
 /// Extract and build the diagnostic database from proto data.
