rough the sovd_adapter. A time-based debounce\n(Debounce::TimeBased semantics) turns an injected stuck sensor into a\nqualified fault. Integration tests drive the running gateway through\nopensovd-client.\n\nRefs #16","tree":{"sha":"dcb3fcd633a05c58c944d8fe21327e6c3f7a26d1","url":"https://api.github.com/repos/eclipse-score/inc_diagnostics/git/trees/dcb3fcd633a05c58c944d8fe21327e6c3f7a26d1"},"url":"https://api.github.com/repos/eclipse-score/inc_diagnostics/git/commits/4a5c4707965f04d187bcfd21c63d8fc8fd386cb1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/eclipse-score/inc_diagnostics/commits/4a5c4707965f04d187bcfd21c63d8fc8fd386cb1","html_url":"https://github.com/eclipse-score/inc_diagnostics/commit/4a5c4707965f04d187bcfd21c63d8fc8fd386cb1","comments_url":"https://api.github.com/repos/eclipse-score/inc_diagnostics/commits/4a5c4707965f04d187bcfd21c63d8fc8fd386cb1/comments","author":{"login":"erupuri","id":241647247,"node_id":"U_kgDODmc-jw","avatar_url":"https://avatars.githubusercontent.com/u/241647247?v=4","gravatar_id":"","url":"https://api.github.com/users/erupuri","html_url":"https://github.com/erupuri","followers_url":"https://api.github.com/users/erupuri/followers","following_url":"https://api.github.com/users/erupuri/following{/other_user}","gists_url":"https://api.github.com/users/erupuri/gists{/gist_id}","starred_url":"https://api.github.com/users/erupuri/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/erupuri/subscriptions","organizations_url":"https://api.github.com/users/erupuri/orgs","repos_url":"https://api.github.com/users/erupuri/repos","events_url":"https://api.github.com/users/erupuri/events{/privacy}","received_events_url":"https://api.github.com/users/erupuri/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"erupuri","id":241647247,"node_id":"U_kgDODmc-jw","avata