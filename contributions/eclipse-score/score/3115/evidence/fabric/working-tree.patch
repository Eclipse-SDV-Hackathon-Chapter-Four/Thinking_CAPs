+def test_owner_exception_admits_larger_output_preserving_counters_and_bindings(
+    tmp_path: Path,
+) -> None:
+    from score_sw_fabric.optimization.provider_boundary import RequestMeter
+
+    path, pin = exceptional_instruction(tmp_path)
+    state = path.parent / "meter.json"
+    meter = RequestMeter(path, pin, state)
+    payload = request(
+        max_tokens=4096,
+        messages=[
+            {"role": "user", "content": "qualification:lifecycle-704-implementation do task"}
+        ],
+    )
+    for _ in range(2):
+        ticket = meter.reserve(payload)
+        meter.finish(
+            ticket,
+            {
+                "prompt_tokens": 30,
+                "completion_tokens": 20,
+                "prompt_cache_hit_tokens": 10,
+                "prompt_cache_miss_tokens": 20,
+            },
+        )
+        meter = RequestMeter(path, pin, state)
+    observed = json.loads(state.read_bytes())
+    assert observed["requests"] == 2
+    assert observed["reserved_microusd"] > 0
+    assert len(observed["records"]) == 2
+    value = json.loads(path.read_bytes())
+    value["budget_exception"]["task_prefix"] = "qualification:any-"
+    path.write_text(json.dumps(value))
+    with pytest.raises(OptimizationError, match="INSTRUCTION_DIGEST"):
+        meter.reserve(payload)
+
+
+@pytest.mark.parametrize(
+    "mutation",
+    [
+        "missing_owner",
+        "other_task",
+        "other_marker",
+        "unbounded_context",
+        "missing_exception",
+        "missing_governor",
+    ],
+)
+def test_owner_exception_cannot_escape_issue_or_technical_and_governor_bindings(
+    tmp_path: Path, mutation: str
+) -> None:
+    from score_sw_fabric.optimization.activation import governor_limits, verify_instruction
+
+    path, _ = exceptional_instruction(tmp_path)
+    value = json.loads(path.read_bytes())
+    if mutation == "missing_owner":
+        value["budget_exception"]["owner_instruction"] = "go"
+    elif mutation == "other_task":
+        value["task"] = "other-issue"
+    elif mutation == "other_marker":
+        value["tasks"][0]["marker"] = "qualification:other-issue"
+    elif mutation == "unbounded_context":
+        value["budget_exception"]["operational_limits"]["context_tokens"] = 128001
+    elif mutation == "missing_exception":
+        del value["budget_exception"]
+    elif mutation == "missing_governor":
+        del value["files"][str(path.parent / "governor.json")]
+    path.write_text(json.dumps(value))
+    with pytest.raises(OptimizationError):
+        governor_limits(verify_instruction(path, hashlib.sha256(path.read_bytes()).hexdigest()))
+
