+def test_transport_namespaces_ticket_zero_and_refuses_duplicate_artifacts(
+    tmp_path: Path, monkeypatch
+) -> None:
+    import io
+    import threading
+    import urllib.error
+    import urllib.request
+
+    import score_sw_fabric.optimization.provider_boundary as boundary
+
+    first, first_pin, _ = instruction(tmp_path)
+    second_root = tmp_path / "second"
+    second_root.mkdir()
+    second, second_pin, _ = instruction(second_root)
+    forwarded = []
+
+    class Response(io.BytesIO):
+        status = 200
+        headers = {"Content-Type": "application/json"}
+
+    class Opener:
+        def open(self, value, timeout):
+            forwarded.append(value)
+            return Response(
+                json.dumps(
+                    {
+                        "usage": {
+                            "prompt_tokens": 30,
+                            "completion_tokens": 20,
+                            "prompt_cache_hit_tokens": 0,
+                            "prompt_cache_miss_tokens": 30,
+                        }
+                    }
+                ).encode()
+            )
+
+    monkeypatch.setattr(boundary, "build_opener", lambda *args: Opener())
+    original = None
+    for index, (path, pin) in enumerate(
+        [(first, first_pin), (second, second_pin), (first, first_pin)]
+    ):
+        meter = boundary.RequestMeter(path, pin, path.parent / f"meter-{index}.json")
+        server = boundary.boundary_server(meter, 0, "n" * 32, tmp_path)
+        worker = threading.Thread(target=server.serve_forever, daemon=True)
+        worker.start()
+        try:
+            req = urllib.request.Request(
+                f"http://127.0.0.1:{server.server_port}/" + "n" * 32 + "/chat/completions",
+                request(),
+                {"Authorization": "Bearer test-private-key"},
+            )
+            if index < 2:
+                with urllib.request.urlopen(req, timeout=5) as reply:
+                    assert reply.status == 200
+            else:
+                with pytest.raises(urllib.error.HTTPError):
+                    urllib.request.urlopen(req, timeout=5)
+                assert (
+                    json.loads(meter.state.read_bytes())["stopped"] == "PROVIDER_TRANSPORT_FAILED"
+                )
+            file = tmp_path / "provider-records" / first_pin / "native-request-00.json"
+            original = original or file.read_bytes()
+            assert file.read_bytes() == original
+        finally:
+            server.shutdown()
+            server.server_close()
+            worker.join(timeout=5)
+    assert len(forwarded) == 2
+    for pin in (first_pin, second_pin):
+        assert (tmp_path / "provider-records" / pin / "response-00.raw").exists()
