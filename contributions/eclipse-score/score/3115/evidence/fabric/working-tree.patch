+def exceptional_instruction(tmp_path: Path) -> tuple[Path, str]:
+    path, _, _ = instruction(tmp_path)
+    value = json.loads(path.read_bytes())
+    value["task"] = "lifecycle-704-implementation"
+    value["tasks"] = [
+        {
+            "marker": "qualification:lifecycle-704-implementation",
+            "prompt": "qualification:lifecycle-704-implementation do task",
+            "max_requests": 3,
+        }
+    ]
+    value["limits"] = {
+        "requests": None,
+        "cost_microusd": None,
+        "request_bytes": 128000,
+        "output_tokens": 8192,
+    }
+    value["budget_exception"] = {
+        "scope": "current_qualification_only",
+        "owner_instruction": "do it, but you can ignore by now the limited budget for deepseek",
+        "task_prefix": "qualification:lifecycle-704-",
+        "operational_limits": {
+            "input_tokens": 128000,
+            "output_tokens": 8192,
+            "calls": 3,
+            "context_tokens": 128000,
+        },
+    }
+    path.write_text(json.dumps(value))
+    return path, hashlib.sha256(path.read_bytes()).hexdigest()
+
