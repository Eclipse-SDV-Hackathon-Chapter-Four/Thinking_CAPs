warn: No usable model fallbacks remain for requested model `deepseek-v4-flash` after filtering its configured candidates.
{"issues":[{"number":1236,"patch":"diff --git a/tools/lint/buildifier/BUILD b/tools/lint/buildifier/BUILD\nnew file mode 100644\n--- /dev/null\n+++ b/tools/lint/buildifier/BUILD\n@@ -0,0 +1,30 @@\n+# *******************************************************************************\n+# Copyright (c) 2026 Contributors to the Eclipse Foundation\n+#\n+# See the NOTICE file(s) distributed with this work for additional\n+# information regarding copyright ownership.\n+#\n+# This program and the accompanying materials are made available under the\n+# terms of the Apache License Version 2.0 which is available at\n+# https://www.apache.org/licenses/LICENSE-2.0\n+#\n+# SPDX-License-Identifier: Apache-2.0\n+# *******************************************************************************\n+\n+load(\"@rules_python//python:defs.bzl\", \"py_binary\", \"py_test\")\n+\n+py_binary(\n+    name = \"buildifier_lint\",\n+    srcs = [\"buildifier_lint.py\"],\n+    data = [\"@buildifier_prebuilt//:buildifier\"],\n+    main = \"buildifier_lint.py\",\n+    deps = [\"@rules_python//python/runfiles\"],\n+)\n+\n+py_test(\n+    name = \"buildifier_lint_test\",\n+    srcs = [\n+        \"buildifier_lint.py\",\n+        \"buildifier_lint_test.py\",\n+    ],\n+    data = [\n+        \"@buildifier_prebuilt//:buildifier\",\n+        \"clean_fixture.bzl.txt\",\n+        \"warning_fixture.bzl.txt\",\n+    ],\n+    env = {\n+        \"CLEAN_FIXTURE\": \"$(rlocationpath clean_fixture.bzl.txt)\",\n+        \"WARNING_FIXTURE\": \"$(rlocationpath warning_fixture.bzl.txt)\",\n+    },\n+    deps = [\"@rules_python//python/runfiles\"],\n+)\ndiff --git a/tools/lint/buildifier/buildifier_lint.py b/tools/lint/buildifier/buildifier_lint.py\nnew file mode 100644\n--- /dev/null\n+++ b/tools/lint/buildifier/buildifier_lint.py\n@@ -0,0 +1,62 @@\n+# *******************************************************************************\n+# Copyright (c) 2026 Contributors to the Eclipse Foundation\n+#\n+# See the NOTICE file(s) distributed with this work for additional\n+# information regarding copyright ownership.\n+#\n+# This program and the accompanying materials are made available under the\n+# terms of the Apache License Version 2.0 which is available at\n+# https://www.apache.org/licenses/LICENSE-2.0\n+#\n+# SPDX-License-Identifier: Apache-2.0\n+# *******************************************************************************\n+import argparse\n+import os\n+import subprocess\n+import sys\n+\n+from python.runfiles import Runfiles\n+\n+\n+def _find_buildifier():\n+    runfiles = Runfiles.Create()\n+    path = runfiles.Rlocation(\"buildifier_prebuilt/buildifier\")\n+    if not path or not os.path.exists(path):\n+        raise RuntimeError(\"Unable to locate buildifier in runfiles\")\n+    return path\n+\n+\n+def _run_buildifier(buildifier, args):\n+    return subprocess.run([buildifier] + args, capture_output=True, text=True)\n+\n+\n+def _check_result(proc):\n+    output = (proc.stdout or \"\") + (proc.stderr or \"\")\n+    if proc.returncode != 0 or \"warning:\" in output:\n+        if output:\n+            print(output, file=sys.stderr)\n+        return 1\n+    return 0\n+\n+\n+def main(argv=None):\n+    parser = argparse.ArgumentParser(description=\"Run buildifier lint checks.\")\n+    parser.add_argument(\"--recursive\", action=\"store_true\", help=\"Recursively lint the workspace.\")\n+    parser.add_argument(\"--workspace\", help=\"Workspace root for recursive lint.\")\n+    parser.add_argument(\"--type\", default=\"auto\", help=\"Buildifier input type.\")\n+    parser.add_argument(\"files\", nargs=\"*\", help=\"Files to lint.\")\n+    args = parser.parse_args(argv)\n+\n+    buildifier = _find_buildifier()\n+    buildifier_args = [\"-lint=warn\", \"-warnings=all\", \"-mode=check\", f\"-type={args.type}\"]\n+    if args.recursive:\n+        workspace = args.workspace or os.environ.get(\"BUILD_WORKING_DIRECTORY\")\n+        if not workspace:\n+            print(\"--workspace or BUILD_WORKING_DIRECTORY required for recursive lint.\", file=sys.stderr)\n+            return 2\n+        buildifier_args.extend([\"-r\", workspace])\n+    else:\n+        if not args.files:\n+            print(\"No files provided for non-recursive lint.\", file=sys.stderr)\n+            return 2\n+        buildifier_args.extend(args.files)\n+\n+    proc = _run_buildifier(buildifier, buildifier_args)\n+    return _check_result(proc)\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())\ndiff --git a/tools/lint/buildifier/buildifier_lint_test.py b/tools/lint/buildifier/buildifier_lint_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tools/lint/buildifier/buildifier_lint_test.py\n@@ -0,0 +1,34 @@\n+# *******************************************************************************\n+# Copyright (c) 2026 Contributors to the Eclipse Foundation\n+#\n+# See the NOTICE file(s) distributed with this work for additional\n+# information regarding copyright ownership.\n+#\n+# This program and the accompanying materials are made available under the\n+# terms of the Apache License Version 2.0 which is available at\n+# https://www.apache.org/licenses/LICENSE-2.0\n+#\n+# SPDX-License-Identifier: Apache-2.0\n+# *******************************************************************************\n+import os\n+import unittest\n+\n+import buildifier_lint\n+\n+\n+class BuildifierLintTest(unittest.TestCase):\n+    def test_clean_fixture_passes(self):\n+        buildifier = buildifier_lint._find_buildifier()\n+        fixture = os.environ[\"CLEAN_FIXTURE\"]\n+        proc = buildifier_lint._run_buildifier(\n+            buildifier, [\"-lint=warn\", \"-warnings=all\", \"-mode=check\", \"-type=build\", fixture]\n+        )\n+        self.assertEqual(buildifier_lint._check_result(proc), 0, proc.stderr)\n+\n+    def test_warning_fixture_fails(self):\n+        buildifier = buildifier_lint._find_buildifier()\n+        fixture = os.environ[\"WARNING_FIXTURE\"]\n+        proc = buildifier_lint._run_buildifier(\n+            buildifier, [\"-lint=warn\", \"-warnings=all\", \"-mode=check\", \"-type=build\", fixture]\n+        )\n+        self.assertNotEqual(buildifier_lint._check_result(proc), 0, \"Expected warning fixture to fail\")\n+        output = (proc.stdout or \"\") + (proc.stderr or \"\")\n+        self.assertIn(\"warning:\", output)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\ndiff --git a/tools/lint/buildifier/clean_fixture.bzl.txt b/tools/lint/buildifier/clean_fixture.bzl.txt\nnew file mode 100644\n--- /dev/null\n+++ b/tools/lint/buildifier/clean_fixture.bzl.txt\n@@ -0,0 +1,5 @@\n+load(\"@rules_cc//cc:defs.bzl\", \"cc_library\")\n+\n+cc_library(\n+    name = \"clean\",\n+)\ndiff --git a/tools/lint/buildifier/warning_fixture.bzl.txt b/tools/lint/buildifier/warning_fixture.bzl.txt\nnew file mode 100644\n--- /dev/null\n+++ b/tools/lint/buildifier/warning_fixture.bzl.txt\n@@ -0,0 +1,5 @@\n+load(\"@rules_cc//cc:defs.bzl\", \"cc_library\", \"cc_test\")\n+\n+cc_library(\n+    name = \"warning\",\n+)\ndiff --git a/.github/workflows/_linter.yml b/.github/workflows/_linter.yml\n--- a/.github/workflows/_linter.yml\n+++ b/.github/workflows/_linter.yml\n@@ -163,4 +163,26 @@\n             ${{ matrix.id }}_raw.log\n             ${{ matrix.id }}.sarif\n           if-no-files-found: ignore\n           retention-days: 7\n+\n+  buildifier:\n+    name: buildifier\n+    runs-on: ubuntu-24.04\n+    permissions:\n+      contents: read\n+      actions: write\n+    steps:\n+      - uses: actions/checkout@v6.0.2\n+        with:\n+          fetch-depth: 0\n+\n+      - uses: ./.github/actions/00_infrastructure/prepare_bazel_environment\n+        with:\n+          disk-cache: ${{ inputs.fetch-only != 'true' && 'buildifier' || '' }}\n+          cache-mode: ${{ inputs.cache-mode }}\n+          ubuntu-snapshot-mirror-url: ${{ secrets.UBUNTU_SNAPSHOT_MIRROR_URL }}\n+\n+      - name: Run buildifier lint\n+        if: inputs.fetch-only != 'true'\n+        run: |\n+          bazel run --config=ci //tools/lint/buildifier:buildifier_lint -- --recursive\n","rationale":"Adds a runnable Bazel buildifier lint target using the pinned @buildifier_prebuilt tool, a hermetic regression for clean and warning fixtures, and CI enforcement via a new _linter.yml job. The wrapper fails on buildifier warnings (including unused loads) while avoiding malformed BUILD fixtures by using .bzl.txt text fixtures and explicit -type=build. Existing warnings outside allowed scope remain visible and are not suppressed. Engineering acceptance pending."},{"number":751,"patch":"diff --git a/quality/static_analysis/codeql_lint.py b/quality/static_analysis/codeql_lint.py\n--- a/quality/static_analysis/codeql_lint.py\n+++ b/quality/static_analysis/codeql_lint.py\n@@ -50,50 +50,72 @@\n def audit_database_source_coverage(database_path, source_root, expected_sources):\n     \"\"\"Audit that expected source files were extracted into the CodeQL database.\n \n     CodeQL databases retain extracted sources in a ``src.zip`` archive.  This\n     check intentionally inspects that archive instead of the SARIF output: a\n     production source file can legitimately have zero findings and therefore no\n     SARIF result, while still being present in the database.  Conversely, a\n     missing database entry is real evidence that the traced build did not cover\n     the file (for example because the Bazel target pattern was too narrow).\n \n     Args:\n         database_path: Path to the finalized CodeQL database directory.\n         source_root: Root of the source tree used for the traced build.\n         expected_sources: Iterable of source paths (relative to source_root or\n             absolute) that must be present in the database.\n \n     Returns:\n         A sorted list of expected source paths that were not found.\n     \"\"\"\n     src_zip = os.path.join(database_path, DATABASE_SRC_ARCHIVE)\n     if not os.path.isfile(src_zip):\n         raise RuntimeError(\n             f\"CodeQL database source archive not found: {src_zip}. \"\n             \"Cannot audit database source coverage.\"\n         )\n \n-    normalized_expected = []\n-    for source in expected_sources:\n-        if os.path.isabs(source):\n-            try:\n-                rel = os.path.relpath(source, source_root)\n-            except ValueError:\n-                # On Windows, paths on different drives cannot be relative.\n-                rel = source\n-        else:\n-            rel = source\n-        normalized = rel.replace(os.sep, \"/\").lstrip(\"/\")\n-        normalized_expected.append(normalized)\n-\n-    with zipfile.ZipFile(src_zip, \"r\") as archive:\n-        archive_names = set(archive.namelist())\n-\n-    missing = []\n-    for rel in normalized_expected:\n-        if rel not in archive_names and f\"./{rel}\" not in archive_names:\n-            missing.append(rel)\n-    return sorted(missing)\n+    source_root_abs = os.path.abspath(source_root).replace(os.sep, \"/\").lstrip(\"/\")\n+\n+    def _normalize_expected(source):\n+        if os.path.isabs(source):\n+            try:\n+                rel = os.path.relpath(source, source_root)\n+            except ValueError:\n+                # On Windows, paths on different drives cannot be relative.\n+                rel = source\n+        else:\n+            rel = source\n+        return rel.replace(os.sep, \"/\").lstrip(\"/\")\n+\n+    with zipfile.ZipFile(src_zip, \"r\") as archive:\n+        archive_names = set(archive.namelist())\n+\n+    missing = []\n+    for source in expected_sources:\n+        rel = _normalize_expected(source)\n+        candidates = {\n+            rel,\n+            f\"./{rel}\",\n+        }\n+        if source_root_abs:\n+            candidates.add(f\"{source_root_abs}/{rel}\")\n+            candidates.add(f\"./{source_root_abs}/{rel}\")\n+        if not (candidates & archive_names):\n+            missing.append(rel)\n+    return sorted(missing)\n+\n+\n+def _production_target_patterns(target_spec):\n+    patterns = []\n+    for label in target_spec.split():\n+        label = label.strip()\n+        if not label.startswith(\"//\"):\n+            continue\n+        if \":\" in label:\n+            pkg = label[2:].split(\":\", 1)[0]\n+        else:\n+            pkg = label[2:]\n+        patterns.append(f\"//{pkg}/...\")\n+    if not patterns:\n+        raise RuntimeError(\n+            \"No main-repository targets found in the supplied target list; \"\n+            \"cannot derive production targets.\"\n+        )\n+    return patterns\n+\n+\n+def _parse_production_targets(cquery_stdout):\n+    labels = [line.strip() for line in cquery_stdout.splitlines() if line.strip()]\n+    return [label for label in labels if label.startswith(\"//\")]\n+\n+\n+def _compute_production_targets(source_root, build_configs, target_spec):\n+    patterns = _production_target_patterns(target_spec)\n+    query_expr = f'kind(\"cc_library|cc_binary\", {\" + \".join(patterns)})'\n+    cquery_cmd = \"bazel cquery --config=codeql\"\n+    for extra_config in build_configs or []:\n+        cquery_cmd += f\" --config={extra_config}\"\n+    cquery_cmd += f\" --output=label '{query_expr}'\"\n+    result = subprocess.run(\n+        cquery_cmd,\n+        shell=True,\n+        cwd=source_root,\n+        capture_output=True,\n+        text=True,\n+        check=True,\n+    )\n+    labels = _parse_production_targets(result.stdout)\n+    if not labels:\n+        raise RuntimeError(\n+            f\"No production C/C++ targets found in dependency closure of {patterns}.\"\n+        )\n+    return labels\n@@ -160,7 +182,7 @@\n     subprocess.run(\n         f\"{code_ql_path} database init --overwrite --begin-tracing --language=cpp \"\n         f\"--codescanning-config={config_path} --source-root={source_root} -- {database_path}\",\n         shell=True,\n         check=True,\n     )\n@@ -191,7 +213,7 @@\n     bazel_cmd = f\"bazel build --config=codeql --stamp --action_env=CODEQL_SEED_FORCE_RECOMPILE={timestamp}\"\n     for extra_config in build_configs or []:\n         bazel_cmd += f\" --config={extra_config}\"\n     bazel_cmd += _get_action_env_extension(codeql_env)\n+    if production_targets:\n+        production_target_list = _compute_production_targets(source_root, build_configs, target)\n+        target = \" \".join(production_target_list)\n+        bazel_cmd += \" --skip_incompatible_explicit_targets\"\n     subprocess.run(f\"{bazel_cmd} {target}\", shell=True, env=env, cwd=source_root, check=True)\n@@ -320,6 +342,12 @@\n     parser.add_argument(\n         \"--audit-source\",\n         action=\"append\",\n         default=[],\n         dest=\"audit_sources\",\n         metavar=\"PATH\",\n         help=\"Source file expected to be present in the CodeQL database. \"\n         \"Repeatable. Used to audit database source coverage independently of \"\n         \"SARIF results.\",\n     )\n+    parser.add_argument(\n+        \"--production-targets\",\n+        action=\"store_true\",\n+        help=\"When set, explicitly build all non-test C/C++ library and binary \"\n+        \"targets under the supplied native scopes, including implementation_deps \"\n+        \"that would otherwise be built lazily.\",\n+    )\n@@ -346,6 +374,7 @@\n             source_root,\n             args.database_path,\n             build_configs=args.build_configs,\n+            production_targets=args.production_targets,\n         )\n@@ -366,6 +395,7 @@\n                 source_root,\n                 database_location,\n                 build_configs=args.build_configs,\n+                production_targets=args.production_targets,\n             )\ndiff --git a/quality/static_analysis/codeql_lint_test.py b/quality/static_analysis/codeql_lint_test.py\n--- a/quality/static_analysis/codeql_lint_test.py\n+++ b/quality/static_analysis/codeql_lint_test.py\n@@ -44,6 +44,25 @@\n     def test_audit_raises_when_src_zip_is_missing(self):\n         with tempfile.TemporaryDirectory() as tmpdir:\n             with self.assertRaises(RuntimeError):\n                 codeql_lint.audit_database_source_coverage(\n                     tmpdir,\n                     tmpdir,\n                     [\"score/mw/com/impl/plumbing/proxy_binding_factory_impl.cpp\"],\n                 )\n+\n+    def test_audit_accepts_absolute_archive_root_path(self):\n+        with tempfile.TemporaryDirectory() as tmpdir:\n+            relative = \"score/mw/com/impl/plumbing/proxy_binding_factory_impl.cpp\"\n+            source_root = \"/workspace\"\n+            archive_entry = \"workspace/\" + relative\n+            self._create_database_with_sources(tmpdir, [archive_entry])\n+            missing = codeql_lint.audit_database_source_coverage(\n+                tmpdir,\n+                source_root,\n+                [relative],\n+            )\n+            self.assertEqual(missing, [])\n+\n+    def test_audit_rejects_unrelated_absolute_archive_root(self):\n+        with tempfile.TemporaryDirectory() as tmpdir:\n+            relative = \"score/mw/com/impl/plumbing/proxy_binding_factory_impl.cpp\"\n+            source_root = \"/workspace\"\n+            archive_entry = \"other/workspace/\" + relative\n+            self._create_database_with_sources(tmpdir, [archive_entry])\n+            missing = codeql_lint.audit_database_source_coverage(\n+                tmpdir,\n+                source_root,\n+                [relative],\n+            )\n+            self.assertEqual(missing, [relative])\n+\n+\n+class ProductionTargetTest(unittest.TestCase):\n+    def test_production_target_patterns_expand_package_roots(self):\n+        patterns = codeql_lint._production_target_patterns(\n+            \"//score/message_passing //score/mw/com\"\n+        )\n+        self.assertEqual(\n+            patterns,\n+            [\n+                \"//score/message_passing/...\",\n+                \"//score/mw/com/...\",\n+            ],\n+        )\n+\n+    def test_production_target_patterns_reject_empty(self):\n+        with self.assertRaises(RuntimeError):\n+            codeql_lint._production_target_patterns(\"\")\n+\n+    def test_parse_production_targets_filters_external(self):\n+        labels = codeql_lint._parse_production_targets(\n+            \"//score/mw/com/impl:foo\\n@external//bar:baz\\n//score/message_passing:msg\\n\"\n+        )\n+        self.assertEqual(\n+            labels,\n+            [\n+                \"//score/mw/com/impl:foo\",\n+                \"//score/message_passing:msg\",\n+            ],\n+        )\ndiff --git a/.github/workflows/_codeql.yml b/.github/workflows/_codeql.yml\n--- a/.github/workflows/_codeql.yml\n+++ b/.github/workflows/_codeql.yml\n@@ -78,6 +78,7 @@\n             --output-dir /tmp/codeql-results/linux \\\n             --output-prefix codeql-nightly \\\n+            --production-targets \\\n             --target //score/message_passing //score/mw/com \\\n             --audit-source score/mw/com/impl/plumbing/proxy_binding_factory_impl.cpp\n@@ -111,6 +112,7 @@\n             --build-config qnx \\\n             --output-dir /tmp/codeql-results/qnx \\\n             --output-prefix codeql-nightly-qnx \\\n+            --production-targets \\\n             --target //score/message_passing //score/mw/com \\\n             --audit-source score/mw/com/impl/plumbing/proxy_binding_factory_impl.cpp\n","rationale":"Adds opt-in --production-targets to the CodeQL CLI, invoked in both nightly jobs. When enabled it derives configured production C/C++ labels via bazel cquery over the supplied scopes, builds them explicitly (including lazy implementation_deps), skips incompatible explicit targets, and rejects empty selections. The archive audit now matches absolute source-root paths with leading slash removed and rejects unrelated-root suffixes. Regression tests cover selection and absolute-archive-root matching. The native exact #751 verification must still run with --production-targets and confirm the .cpp in src.zip; QNX remains unmeasured separately. Engineering acceptance pending."},{"number":1104,"patch":"diff --git a/quality/static_analysis/BUILD b/quality/static_analysis/BUILD\n--- a/quality/static_analysis/BUILD\n+++ b/quality/static_analysis/BUILD\n@@ -11,7 +11,7 @@\n-load(\"@rules_python//python:defs.bzl\", \"py_binary\")\n+load(\"@rules_python//python:defs.bzl\", \"py_binary\", \"py_test\")\n@@ -34,6 +34,14 @@\n     deps = [\"@rules_python//python/runfiles\"],\n )\n \n+py_test(\n+    name = \"codeql_lint_test\",\n+    srcs = [\n+        \"codeql_lint.py\",\n+        \"codeql_lint_test.py\",\n+    ],\n+    target_compatible_with = [\"@platforms//os:linux\"],\n+)\n+\n filegroup(\n     name = \"config\",\n     srcs = [\"config.yaml\"],\n )\ndiff --git a/quality/static_analysis/codeql_lint.py b/quality/static_analysis/codeql_lint.py\n--- a/quality/static_analysis/codeql_lint.py\n+++ b/quality/static_analysis/codeql_lint.py\n@@ -234,6 +234,40 @@\n     os.replace(normalized_sarif_path, sarif_path)\n     return sarif_path\n \n \n+PLACEHOLDER_URIS = {\"file:/\", \"file:\", \"file:///\", \"\"}\n+\n+\n+def _normalize_placeholder_artifact_locations(value):\n+    if isinstance(value, dict):\n+        if value.get(\"uri\") in PLACEHOLDER_URIS and \"index\" in value:\n+            del value[\"uri\"]\n+        artifact_location = value.get(\"artifactLocation\")\n+        if isinstance(artifact_location, dict):\n+            uri = artifact_location.get(\"uri\")\n+            if uri in PLACEHOLDER_URIS:\n+                if \"index\" in artifact_location:\n+                    del artifact_location[\"uri\"]\n+                else:\n+                    del value[\"artifactLocation\"]\n+        for child in value.values():\n+            _normalize_placeholder_artifact_locations(child)\n+    elif isinstance(value, list):\n+        for child in value:\n+            _normalize_placeholder_artifact_locations(child)\n+\n+\n+def normalize_sarif_placeholder_locations(sarif_path):\n+    with open(sarif_path, \"r\", encoding=\"utf-8\") as sarif_file:\n+        sarif = json.load(sarif_file)\n+\n+    for run in sarif.get(\"runs\", []):\n+        _normalize_placeholder_artifact_locations(run)\n+\n+    normalized_sarif_path = f\"{sarif_path}.placeholder_normalized\"\n+    with open(normalized_sarif_path, \"w\", encoding=\"utf-8\") as sarif_file:\n+        json.dump(sarif, sarif_file, indent=2)\n+        sarif_file.write(\"\\n\")\n+    os.replace(normalized_sarif_path, sarif_path)\n+    return sarif_path\n+\n+\n def _normalize_sarif_run(run):\n@@ -291,6 +325,7 @@\n     recategorize_sarif(\n         recategorize_path,\n         coding_standards_config_path,\n         sarif_path,\n     )\n     normalize_sarif_rule_order(sarif_path)\n+    normalize_sarif_placeholder_locations(sarif_path)\n \n     # Generate reports using CodeQL analysis_report tool\ndiff --git a/quality/static_analysis/codeql_lint_test.py b/quality/static_analysis/codeql_lint_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/quality/static_analysis/codeql_lint_test.py\n@@ -0,0 +1,76 @@\n+# *******************************************************************************\n+# Copyright (c) 2026 Contributors to the Eclipse Foundation\n+#\n+# See the NOTICE file(s) distributed with this work for additional\n+# information regarding copyright ownership.\n+#\n+# This program and the accompanying materials are made available under the\n+# terms of the Apache License Version 2.0 which is available at\n+# https://www.apache.org/licenses/LICENSE-2.0\n+#\n+# SPDX-License-Identifier: Apache-2.0\n+# *******************************************************************************\n+import json\n+import os\n+import tempfile\n+import unittest\n+\n+import codeql_lint\n+\n+\n+class NormalizePlaceholderLocationsTest(unittest.TestCase):\n+    def test_removes_placeholder_uri_with_index(self):\n+        sarif = {\n+            \"runs\": [\n+                {\n+                    \"artifacts\": [\n+                        {\"location\": {\"uri\": \"file:/\", \"index\": 101}},\n+                    ],\n+                    \"results\": [\n+                        {\n+                            \"relatedLocations\": [\n+                                {\n+                                    \"physicalLocation\": {\n+                                        \"artifactLocation\": {\"uri\": \"file:/\"}\n+                                    },\n+                                    \"message\": {\"text\": \"Result\"},\n+                                }\n+                            ]\n+                        }\n+                    ],\n+                }\n+            ]\n+        }\n+        codeql_lint._normalize_placeholder_artifact_locations(sarif)\n+        artifact_location = sarif[\"runs\"][0][\"artifacts\"][0][\"location\"]\n+        self.assertNotIn(\"uri\", artifact_location)\n+        self.assertEqual(artifact_location[\"index\"], 101)\n+        related_physical = sarif[\"runs\"][0][\"results\"][0][\"relatedLocations\"][0][\"physicalLocation\"]\n+        self.assertNotIn(\"artifactLocation\", related_physical)\n+\n+    def test_preserves_valid_uri(self):\n+        sarif = {\n+            \"runs\": [\n+                {\n+                    \"results\": [\n+                        {\n+                            \"physicalLocation\": {\n+                                \"artifactLocation\": {\n+                                    \"uri\": \"score/mw/com/impl/foo.cpp\",\n+                                }\n+                            }\n+                        }\n+                    ]\n+                }\n+            ]\n+        }\n+        codeql_lint._normalize_placeholder_artifact_locations(sarif)\n+        artifact_location = sarif[\"runs\"][0][\"results\"][0][\"physicalLocation\"][\"artifactLocation\"]\n+        self.assertEqual(artifact_location[\"uri\"], \"score/mw/com/impl/foo.cpp\")\n+\n+    def test_normalize_sarif_placeholder_locations_writes_file(self):\n+        with tempfile.TemporaryDirectory() as tmpdir:\n+            sarif_path = os.path.join(tmpdir, \"out.sarif\")\n+            sarif = {\n+                \"runs\": [\n+                    {\n+                        \"results\": [\n+                            {\n+                                \"physicalLocation\": {\n+                                    \"artifactLocation\": {\"uri\": \"file:/\"}\n+                                }\n+                            }\n+                        ]\n+                    }\n+                ]\n+            }\n+            with open(sarif_path, \"w\") as f:\n+                json.dump(sarif, f)\n+            codeql_lint.normalize_sarif_placeholder_locations(sarif_path)\n+            with open(sarif_path, \"r\") as f:\n+                normalized = json.load(f)\n+            physical = normalized[\"runs\"][0][\"results\"][0][\"physicalLocation\"]\n+            self.assertNotIn(\"artifactLocation\", physical)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n","rationale":"Adds normalization for root-only/empty file URIs in SARIF. Placeholder artifactLocations with an index drop the bogus URI and keep the index so findings resolve to real artifacts; placeholder locations without an index drop the invalid artifactLocation while preserving the finding, message and physicalLocation object as unlocated evidence. Valid relative/absolute/file URIs and finding identities/counts are preserved. Regression tests cover placeholder removal with/without index and valid-URI preservation. The exact impl/... extraction refusal is retained separately; a passing diagnostic projection over nightly roots does not make the failed exact invocation pass. Engineering acceptance pending."}],"rationale":"Three bounded corrections produced. #1236 adds a fail-on-warning buildifier lint target, hermetic fixtures and CI enforcement. #751 adds opt-in --production-targets with configured production label selection, absolute-root archive audit matching and regressions. #1104 normalizes root-only/empty file URIs without inventing locations or dropping findings. All engineering acceptance remains pending; native QNX and full CodeQL/build measurements remain outstanding."}
