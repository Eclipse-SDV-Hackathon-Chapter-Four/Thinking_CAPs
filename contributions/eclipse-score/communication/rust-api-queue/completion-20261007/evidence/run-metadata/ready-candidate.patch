+        drop(subscriber);
+    }
+
+    #[test]
+    fn test_set_handler_failure_drops_captured_resource() {
+        let drops = Arc::new(AtomicUsize::new(0));
+        let counter = DropCounter(Arc::clone(&drops));
+
+        let mut mock = MockFFIBridge::new();
+        // The middleware refuses the handler before taking ownership, so the runtime keeps
+        // ownership of the boxed closure and must reclaim (drop) it.
+        mock.expect_set_subscription_state_change_handler()
+            .returning(|_, _| false);
+        // No unset expectation: the registration flag stays false, so Drop must not call unset.
+        let (subscriber, _proxy_alloc, _event_alloc) = make_subscribed(mock, teardown_order());
+
+        let err = subscriber
+            .set_subscription_state_change_handler(move |_state| {
+                // Touch the captured resource so the closure owns it and its drop is observable.
+                counter.touch();
+                true
+            })
+            .expect_err("a failed registration must be reported");
+        assert!(matches!(
+            err,
+            Error::EventError(EventFailedReason::SubscriptionStateChangeHandlerFailed)
+        ));
+        assert_eq!(
+            drops.load(std::sync::atomic::Ordering::SeqCst),
+            1,
+            "the refused handler's captured resource must be dropped exactly once"
+        );
+        drop(subscriber.unsubscribe());
+    }
+
+    #[test]
+    fn test_set_and_unset_disposes_captured_resource_exactly_once() {
+        let drops = Arc::new(AtomicUsize::new(0));
+        let counter = DropCounter(Arc::clone(&drops));
+        let slot = handler_slot();
+
+        let mut mock = MockFFIBridge::new();
+        expect_set_handler_success(&mut mock, Arc::clone(&slot));
+        expect_unset_disposes(&mut mock, Arc::clone(&slot));
+
+        let (subscriber, _proxy_alloc, _event_alloc) = make_subscribed(mock, teardown_order());
+        subscriber
+            .set_subscription_state_change_handler(move |_state| {
+                counter.touch();
+                true
+            })
+            .expect("registering the handler should succeed");
+        subscriber
+            .unset_subscription_state_change_handler()
+            .expect("unregistering the handler should succeed");
+        assert_eq!(
+            drops.load(std::sync::atomic::Ordering::SeqCst),
+            1,
+            "explicit unset must dispose the captured resource exactly once"
+        );
+        // Explicit unset clears the flag, so Drop must NOT call unset a second time (times(1)).
+        drop(subscriber.unsubscribe());
+        assert_eq!(
+            drops.load(std::sync::atomic::Ordering::SeqCst),
+            1,
+            "teardown after an explicit unset must not dispose the resource again"
+        );
+    }
+
+    #[test]
+    fn test_drop_unregisters_before_unsubscribe_and_disposes_once() {
+        let drops = Arc::new(AtomicUsize::new(0));
+        let counter = DropCounter(Arc::clone(&drops));
+        let order = teardown_order();
+        let slot = handler_slot();
+
+        let mut mock = MockFFIBridge::new();
+        expect_set_handler_success(&mut mock, Arc::clone(&slot));
+        {
+            let order = Arc::clone(&order);
+            let slot = Arc::clone(&slot);
+            mock.expect_unset_subscription_state_change_handler()
+                .times(1)
+                .returning(move |_| {
+                    order.lock().expect("teardown order mutex poisoned").push("unset");
+                    if let Some(handler) = slot.lock().expect("handler slot mutex poisoned").take() {
+                        // SAFETY: the recorded handler is still alive and is disposed once.
+                        unsafe { dispose_state_handler(handler.0) };
+                    }
+                    true
+                });
+        }
