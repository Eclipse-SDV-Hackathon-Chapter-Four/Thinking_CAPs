+    /// Test-only marker that lets the raw `FatPtr` handed to the bridge be observed through a
+    /// mockall expectation (mockall requires `Send` closures).
+    ///
+    /// The runtime creates the handler as `Box<dyn FnMut(u8) -> bool + Send + 'static>` and the
+    /// middleware may invoke it from another thread, so treating the pointer as `Send` matches the
+    /// production FFI contract; the pointee is still only dereferenced while the box is alive.
+    #[derive(Clone, Copy)]
+    struct SendFatPtr(FatPtr);
+
+    // SAFETY: the pointee trait object is `Send` (enforced by the public API) and the pointer is
+    // only dereferenced while the box is alive on the middleware side.
+    unsafe impl Send for SendFatPtr {}
+    // SAFETY: access is serialised by the owning mock/teardown flows; the pointee is never
+    // invoked concurrently from Rust.
+    unsafe impl Sync for SendFatPtr {}
+
+    /// Shared slot populated with the handler pointer that the runtime hands to the bridge.
+    type HandlerSlot = Arc<std::sync::Mutex<Option<SendFatPtr>>>;
+
+    fn handler_slot() -> HandlerSlot {
+        Arc::new(std::sync::Mutex::new(None))
+    }
+
+    /// Shared recording of bridge calls, used to assert teardown ordering.
+    fn teardown_order() -> Arc<std::sync::Mutex<Vec<&'static str>>> {
+        Arc::new(std::sync::Mutex::new(Vec::new()))
+    }
+
+    /// Counts drops of a resource captured by a handler closure so tests can assert that the
+    /// boxed handler is reclaimed exactly once (no leak and no double disposal).
+    #[derive(Debug)]
+    struct DropCounter(Arc<AtomicUsize>);
+
+    impl DropCounter {
+        /// Keeps a handler closure owning the whole wrapper (not just the inner `Arc`) so that
+        /// dropping the boxed closure is what runs [`DropCounter::drop`].
+        fn touch(&self) {}
+    }
+
+    impl Drop for DropCounter {
+        fn drop(&mut self) {
+            self.0.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        }
+    }
+
+    /// Invokes a recorded handler exactly as `mw_com_impl_call_dyn_ref_fnmut_subscription_state`
+    /// does, using the same `FnMut(u8) -> bool + Send + 'static` trait-object type as the boxing
+    /// site so the reconstructed vtable is the one the box was created with.
+    ///
+    /// # Safety
+    /// `handler` must be a live handler pointer that has not been disposed yet.
+    unsafe fn invoke_state_handler(handler: FatPtr, new_state: u8) -> bool {
+        // SAFETY: `handler` was produced from that exact box type and the box is still alive.
+        let callable: *mut (dyn FnMut(u8) -> bool + Send + 'static) = unsafe { std::mem::transmute(handler) };
+        // SAFETY: `callable` points to a live allocation produced by `Box::into_raw`.
+        unsafe { (*callable)(new_state) }
+    }
+
+    /// Drops a recorded handler exactly as the typed dispose trampoline
+    /// `mw_com_impl_delete_boxed_fnmut_subscription_state` does. Consuming the pointer makes it
+    /// impossible for this helper to dispose the same box twice.
+    ///
+    /// # Safety
+    /// `handler` must be a live handler pointer that has not been disposed before.
+    unsafe fn dispose_state_handler(handler: FatPtr) {
+        // SAFETY: `handler` was produced from that exact box type and is consumed exactly once.
+        let callable: *mut (dyn FnMut(u8) -> bool + Send + 'static) = unsafe { std::mem::transmute(handler) };
+        // SAFETY: `callable` is the live box produced by `Box::into_raw`; it is freed exactly once.
+        drop(unsafe { Box::from_raw(callable) });
+    }
+
+    /// Configures the mock "set" side so a successful registration records the handler pointer,
+    /// exactly like the middleware keeping the callback for later invocation.
+    fn expect_set_handler_success(mock: &mut MockFFIBridge, slot: HandlerSlot) {
+        mock.expect_set_subscription_state_change_handler()
+            .returning(move |_, handler| {
+                *slot.lock().expect("handler slot mutex poisoned") = Some(SendFatPtr(*handler));
+                true
+            });
+    }
+
+    /// Configures the mock "unset" side to dispose the recorded handler exactly once, mirroring
+    /// the C++ middleware that owns the callback and drops it when it is unregistered.
+    fn expect_unset_disposes(mock: &mut MockFFIBridge, slot: HandlerSlot) {
+        mock.expect_unset_subscription_state_change_handler()
+            .times(1)
+            .returning(move |_| {
+                if let Some(handler) = slot.lock().expect("handler slot mutex poisoned").take() {
+                    // SAFETY: the recorded handler is still alive and has not been disposed.
+                    unsafe { dispose_state_handler(handler.0) };
+                }
+                true
+            });
+    }
+
+    // Builds a subscribed `LolaSubscriberImpl` with the standard proxy/event/type-ops mock setup
+    // and the common teardown expectations. Test-specific expectations for the subscription-state
+    // methods must be registered on `mock` by the caller before calling this helper. The
+    // `teardown_order` log records the `unsubscribe` call so tests can assert that the state
+    // handler is unregistered before the event is unsubscribed.
+    fn make_subscribed(
+        mut mock: MockFFIBridge,
+        teardown_order: Arc<std::sync::Mutex<Vec<&'static str>>>,
+    ) -> (
+        LolaSubscriberImpl<TestData, SharedMockBridge>,
+        MockPointerAllocator<ProxyBase>,
+        MockPointerAllocator<ProxyEventBase>,
+    ) {
+        let proxy_alloc = MockPointerAllocator::<ProxyBase>::new();
+        let event_alloc = MockPointerAllocator::<ProxyEventBase>::new();
+        let type_ops_alloc = MockPointerAllocator::<TypeOperations>::new();
+        let prox = proxy_alloc.clone();
+        let evt = event_alloc.clone();
+        mock.expect_create_proxy().returning(move |_, _| prox.allocate());
+        mock.expect_get_event_from_proxy()
+            .returning(move |_, _, _| evt.allocate());
+        mock.expect_subscribe_to_event().returning(|_, _| true);
+        mock.expect_get_type_ops_instance().returning(move |_, _| {
+            Some(TypeOperationsManager::new(
+                NonNull::new(type_ops_alloc.allocate()).expect("Failed to allocate TypeOperations"),
+            ))
+        });
+        let evt_cleanup = event_alloc.clone();
+        let order = Arc::clone(&teardown_order);
+        mock.expect_unsubscribe_to_event().returning(move |ptr| {
+            order.lock().expect("teardown order mutex poisoned").push("unsubscribe");
+            assert!(
+                evt_cleanup.free(ptr),
+                "unsubscribe_to_event called with unknown pointer"
+            );
+        });
+        let prox_cleanup = proxy_alloc.clone();
+        mock.expect_destroy_proxy().returning(move |ptr| {
+            assert!(prox_cleanup.free(ptr), "destroy_proxy called with unknown pointer");
+        });
+
+        let bridge = SharedMockBridge::new(mock);
+        let subscribable = LolaSubscribableImpl::<TestData, SharedMockBridge> {
+            identifier: "TestEvent",
+            instance_info: make_instance_info(bridge.clone()),
+            proxy_instance: make_proxy_instance(bridge.clone(), "TestInterface"),
+            data: PhantomData,
+        };
+        let subscriber = subscribable.subscribe(3).expect("subscribe should succeed");
+        (subscriber, proxy_alloc, event_alloc)
+    }
+
+    #[test]
+    fn test_get_subscription_state_maps_raw_values() {
+        for (raw, expected) in [
+            (0u8, SubscriptionState::Subscribed),
+            (1u8, SubscriptionState::NotSubscribed),
+            (2u8, SubscriptionState::SubscriptionPending),
+            (255u8, SubscriptionState::NotSubscribed),
+        ] {
+            let mut mock = MockFFIBridge::new();
+            mock.expect_get_subscription_state().returning(move |_| raw);
+            let (subscriber, proxy_alloc, event_alloc) = make_subscribed(mock, teardown_order());
+            assert_eq!(subscriber.get_subscription_state(), expected, "raw value {raw}");
