+std::vector<InstanceIdentifier> Runtime::GetConfiguredServiceWildcardIdentifiers()
+{
+    if (mock_ != nullptr)
+    {
+        return {};
+    }
+    auto& runtime = getInstanceInternal();
+    auto& state = GetConfiguredDiscoveryState();
+    std::lock_guard<std::mutex> lock{state.mutex};
+    if (state.identifiers.has_value())
+    {
+        return state.identifiers.value();
+    }
+
+    std::vector<InstanceIdentifier> identifiers{};
+    std::set<ServiceIdentifierType> handled_service_types{};
+
+    // Enumerate the configured universe through Configuration's public accessors only. GetServiceTypeNames() returns
+    // names (which lose the version), so we group by the full ServiceIdentifierType taken from each instance
+    // deployment; two configured types sharing a name but differing in version therefore stay distinct.
+    for (const auto& service_type_name : runtime.configuration_.GetServiceTypeNames())
+    {
+        for (const auto& instance_name : runtime.configuration_.GetInstancesOfServiceType(service_type_name))
+        {
+            const auto specifier = InstanceSpecifier::Create(std::string{instance_name});
+            if (!specifier.has_value())
+            {
+                continue;
+            }
+            const auto instance_deployment = runtime.configuration_.GetServiceInstanceDeployment(specifier.value());
+            if (!instance_deployment.has_value())
+            {
+                continue;
+            }
+            const auto& deployment = instance_deployment.value().get();
+            // Exactly one wildcard watch per distinct configured service type.
+            if (!handled_service_types.insert(deployment.service_).second)
+            {
+                continue;
+            }
+            const auto type_deployment = runtime.configuration_.GetServiceTypeDeployment(deployment.service_);
+            if (!type_deployment.has_value())
+            {
+                continue;
+            }
+
+            // Build an owned wildcard deployment: instance id removed, which is what native FindService interprets as
+            // "any instance of this service type" (see EnrichedInstanceIdentifier documentation). The wildcard
+            // deployment and its type deployment are copied into address-stable storage owned by this singleton so
+            // that the resulting InstanceIdentifier (and any HandleType produced from it by native discovery) keeps
+            // pointing at live objects for the whole process lifetime.
+            ServiceInstanceDeployment wildcard_deployment{deployment};
+            auto* const lola_instance_deployment =
+                std::get_if<LolaServiceInstanceDeployment>(&wildcard_deployment.bindingInfo_);
+            if (lola_instance_deployment == nullptr)
+            {
+                continue;
+            }
+            lola_instance_deployment->instance_id_ = std::nullopt;
+
+            state.instances.push_back(std::move(wildcard_deployment));
+            state.types.push_back(type_deployment.value().get());
+            identifiers.push_back(make_InstanceIdentifier(state.instances.back(), state.types.back()));
+        }
+    }
+
+    state.identifiers = identifiers;
+    return identifiers;
+}
