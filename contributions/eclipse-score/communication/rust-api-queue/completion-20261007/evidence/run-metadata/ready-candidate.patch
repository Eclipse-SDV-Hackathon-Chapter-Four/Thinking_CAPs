+        let (subscriber, _proxy_alloc, _event_alloc) = make_subscribed(mock, Arc::clone(&order));
+        subscriber
+            .set_subscription_state_change_handler(move |_state| {
+                counter.touch();
+                true
+            })
+            .expect("registering the handler should succeed");
