+    fn set_subscription_state_change_handler(
+        &self,
+        handler: impl FnMut(SubscriptionState) -> bool + Send + 'static,
+    ) -> Result<()>;
+
+    /// Unregisters the subscription state change handler, if any.
+    ///
+    /// After this method returns it is guaranteed that a previously registered handler is no
+    /// longer active and will not be called.
+    ///
+    /// # Errors
+    /// Returns [`Error::EventError`] if the handler cannot be unregistered.
+    fn unset_subscription_state_change_handler(&self) -> Result<()>;
 }
 
