+
+    #[test]
+    fn test_handler_observed_mapped_state_and_mutated_capture() {
+        let observed = Arc::new(std::sync::Mutex::new(Vec::<SubscriptionState>::new()));
+        let handler_observed = Arc::clone(&observed);
+        let slot = handler_slot();
+
+        let mut mock = MockFFIBridge::new();
+        expect_set_handler_success(&mut mock, Arc::clone(&slot));
+        expect_unset_disposes(&mut mock, Arc::clone(&slot));
+
+        let (subscriber, _proxy_alloc, _event_alloc) = make_subscribed(mock, teardown_order());
+        subscriber
+            .set_subscription_state_change_handler(move |state| {
+                handler_observed
+                    .lock()
+                    .expect("observed state mutex poisoned")
+                    .push(state);
+                true
+            })
+            .expect("registering the handler should succeed");
+
+        let handler = {
+            let guard = slot.lock().expect("handler slot mutex poisoned");
+            guard
+                .as_ref()
+                .copied()
+                .expect("the handler pointer must be recorded by the bridge")
+                .0
+        };
+
+        // Raw `u8` values cross the FFI seam and are mapped to the typed state by the adapter;
+        // the closure observes each mapped value and mutates its captured state.
+        assert!(
+            unsafe { invoke_state_handler(handler, 2) },
+            "a true return must keep the handler registered"
+        );
+        assert!(
+            unsafe { invoke_state_handler(handler, 7) },
+            "an out-of-contract raw value maps to NotSubscribed"
+        );
+        assert_eq!(
+            *observed.lock().expect("observed state mutex poisoned"),
+            vec![SubscriptionState::SubscriptionPending, SubscriptionState::NotSubscribed],
+            "the handler must observe the mapped SubscriptionState values in order"
+        );
+
+        // Teardown unregisters and disposes the handler exactly once.
+        drop(subscriber);
+    }
+
+    #[test]
+    fn test_handler_false_return_signals_cancellation() {
+        let slot = handler_slot();
+        let mut mock = MockFFIBridge::new();
+        expect_set_handler_success(&mut mock, Arc::clone(&slot));
+        expect_unset_disposes(&mut mock, Arc::clone(&slot));
+
+        let (subscriber, _proxy_alloc, _event_alloc) = make_subscribed(mock, teardown_order());
+        subscriber
+            .set_subscription_state_change_handler(|_state| false)
+            .expect("registering the handler should succeed");
+
+        let handler = {
+            let guard = slot.lock().expect("handler slot mutex poisoned");
+            guard
+                .as_ref()
+                .copied()
+                .expect("the handler pointer must be recorded by the bridge")
+                .0
+        };
+
+        // The `false` return is propagated across the adapter/trampoline; unregistering the
+        // handler on `false` is the C++ state machine's decision, not the Rust adapter's.
+        assert!(
+            !unsafe { invoke_state_handler(handler, 1) },
+            "a false return must be propagated so the middleware can unregister the handler"
+        );
