+    fn drain<B: FFIBridge>(state: &Arc<StreamState<B>>) -> Vec<Result<ServiceDescriptor>> {
+        state.members.lock().unwrap().pending.drain(..).map(|(_, descriptor)| Ok(descriptor)).collect()
+    }
