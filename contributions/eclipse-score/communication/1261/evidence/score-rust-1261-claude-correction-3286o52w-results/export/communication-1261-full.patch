+        };
+        for mut watch in watches {
+            // SAFETY: this handle was returned by start_find_service_any and has not been stopped yet.
+            unsafe { watch.bridge.stop_find_service(watch.handle.as_mut() as *mut FindServiceHandle) };
+        }
+    }
