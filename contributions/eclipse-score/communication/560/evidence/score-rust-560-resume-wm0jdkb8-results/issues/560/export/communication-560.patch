+    {
+        return mw_com_impl_call_dyn_ref_fnmut_subscription_state(&ptr_, static_cast<std::uint8_t>(new_state));
+    }
+
+    static void dispose(FatPtr ptr_) noexcept
+    {
+        mw_com_impl_delete_boxed_fnmut_subscription_state(&ptr_);
+    }
