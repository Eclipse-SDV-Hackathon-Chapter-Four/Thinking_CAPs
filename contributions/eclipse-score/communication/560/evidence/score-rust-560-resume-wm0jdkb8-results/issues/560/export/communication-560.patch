+/// State of an event subscription.
+///
+/// This mirrors the C++ middleware enumeration `score::mw::com::impl::SubscriptionState`
+/// (AUTOSAR `SWS_CM_00310`). The discriminants form part of the ABI contract with the C++
+/// implementation and must not be changed.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[repr(u8)]
+pub enum SubscriptionState {
+    /// The subscription has been successfully acknowledged by the provider side and the
+    /// consumer has not been notified that the service is no longer offered.
+    Subscribed = 0,
+    /// No subscription exists: `subscribe` has not been called yet or the last successful
+    /// subscription was withdrawn/rejected, or the provider cancelled it.
+    NotSubscribed = 1,
+    /// The subscription request is being dispatched/acknowledged by the provider, or the
+    /// provider has stopped offering and the consumer is waiting to auto-reconnect.
+    SubscriptionPending = 2,
+}
+
+impl From<u8> for SubscriptionState {
+    /// Converts the raw enumeration value received from the middleware.
+    ///
+    /// Unknown values are mapped to [`SubscriptionState::NotSubscribed`] because an unknown
+    /// value cannot represent an active subscription; a value outside of the documented
+    /// contract indicates an ABI mismatch between the Rust and C++ layers.
+    fn from(value: u8) -> Self {
+        match value {
+            0 => Self::Subscribed,
+            2 => Self::SubscriptionPending,
+            // 1 and any out-of-contract value mean "no active subscription".
+            _ => Self::NotSubscribed,
+        }
+    }
+}
