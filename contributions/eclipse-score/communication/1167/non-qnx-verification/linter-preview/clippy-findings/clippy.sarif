{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "clippy",
          "informationUri": "https://rust-lang.github.io/rust-clippy/",
          "rules": [
            {
              "id": "clippy::result_unit_err",
              "fullDescription": {
                "text": "use a custom `Error` type instead\nfor further information visit https://rust-lang.github.io/rust-clippy/master/index.html#result_unit_err\n`#[warn(clippy::result_unit_err)]` on by default\n"
              },
              "helpUri": "https://rust-lang.github.io/rust-clippy/master/index.html#result_unit_err"
            },
            {
              "id": "dead_code",
              "fullDescription": {
                "text": "`#[warn(dead_code)]` (part of `#[warn(unused)]`) on by default\n"
              }
            },
            {
              "id": "clippy::missing_transmute_annotations",
              "fullDescription": {
                "text": "for further information visit https://rust-lang.github.io/rust-clippy/master/index.html#missing_transmute_annotations\n`#[warn(clippy::missing_transmute_annotations)]` on by default\n"
              },
              "helpUri": "https://rust-lang.github.io/rust-clippy/master/index.html#missing_transmute_annotations"
            },
            {
              "id": "clippy::clone_on_copy",
              "fullDescription": {
                "text": "for further information visit https://rust-lang.github.io/rust-clippy/master/index.html#clone_on_copy\n`#[warn(clippy::clone_on_copy)]` on by default\n"
              },
              "helpUri": "https://rust-lang.github.io/rust-clippy/master/index.html#clone_on_copy"
            }
          ]
        }
      },
