+/// \brief Specialization of RustBoxedCallable for subscription state change notifications
+/// \details The invoked Rust closure returns a bool telling the middleware whether the handler
+/// shall be kept (true) or unregistered (false). Disposal drops the boxed closure through the
+/// matching typed deleter.
+template <>
+class RustBoxedCallable<bool, ::score::mw::com::impl::SubscriptionState>
+{
+  public:
+    static bool invoke(FatPtr ptr_, ::score::mw::com::impl::SubscriptionState new_state) noexcept
+    {
+        return mw_com_impl_call_dyn_ref_fnmut_subscription_state(&ptr_, static_cast<std::uint8_t>(new_state));
+    }
+
+    static void dispose(FatPtr ptr_) noexcept
+    {
+        mw_com_impl_delete_boxed_fnmut_subscription_state(&ptr_);
+    }
+};
+
 /// Base class for Rust FnMut callable wrappers
 template <template <typename, typename...> class FnMutHandler, typename R, typename... Args>
 class RustFnMutCallableBase
