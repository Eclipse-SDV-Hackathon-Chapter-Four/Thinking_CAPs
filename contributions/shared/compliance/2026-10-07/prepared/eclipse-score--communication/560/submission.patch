+    fn get_subscription_state(&self) -> SubscriptionState {
+        // SAFETY: the event pointer is valid for the lifetime of the subscription and the
+        // ProxyEventManager guard serialises access to it.
+        let raw = unsafe {
+            self.instance_info
+                .bridge
+                .get_subscription_state(self.event.get_proxy_event().deref_mut())
+        };
+        SubscriptionState::from(raw)
+    }
+
+    fn set_subscription_state_change_handler(
+        &self,
+        mut handler: impl FnMut(SubscriptionState) -> bool + Send + 'static,
+    ) -> Result<()> {
+        // Adapt the typed user handler to the raw `u8` ABI used at the FFI boundary.
+        // `handler` must be a mutable binding because the adapter closure invokes it as `FnMut`.
+        let adapted = move |raw_state: u8| -> bool { handler(SubscriptionState::from(raw_state)) };
+        let boxed: Box<dyn FnMut(u8) -> bool + Send + 'static> = Box::new(adapted);
+        let raw_ptr = Box::into_raw(boxed);
+        // SAFETY: `raw_ptr` is a live fat pointer to `dyn FnMut(u8) -> bool + Send`; FatPtr is its
+        // binary representation (data pointer + vtable pointer), as used by the existing
+        // trampolines.
+        let fat_ptr: FatPtr = unsafe { std::mem::transmute(raw_ptr) };
+        // SAFETY: the event pointer is valid for the subscription lifetime; `fat_ptr` references a
+        // closure that stays alive until the middleware disposes it (on unset, on a `false` return,
+        // or on event destruction). C++ only refuses the handler on a null argument, before it
+        // takes ownership, so a `false` result means we still own the box.
+        let status = unsafe {
+            self.instance_info
+                .bridge
+                .set_subscription_state_change_handler(self.event.get_proxy_event().deref_mut(), &fat_ptr)
+        };
+        if !status {
+            // SAFETY: `raw_ptr` came from `Box::into_raw` above and was not consumed by the
+            // middleware because the call failed.
+            drop(unsafe { Box::from_raw(raw_ptr) });
+            return Err(Error::EventError(EventFailedReason::SubscriptionStateChangeHandlerFailed));
+        }
+        self.subscription_state_handler_set
+            .store(true, std::sync::atomic::Ordering::Release);
+        Ok(())
+    }
+
+    fn unset_subscription_state_change_handler(&self) -> Result<()> {
+        // SAFETY: the event pointer is valid for the subscription lifetime and the guard
+        // serialises access to it.
+        let status = unsafe {
+            self.instance_info
+                .bridge
+                .unset_subscription_state_change_handler(self.event.get_proxy_event().deref_mut())
+        };
+        if !status {
+            return Err(Error::EventError(EventFailedReason::SubscriptionStateChangeHandlerFailed));
+        }
+        self.subscription_state_handler_set
+            .store(false, std::sync::atomic::Ordering::Release);
+        Ok(())
+    }
 }
 
