+/// Rust closure invocation for subscription state change notifications.
+///
+/// Called by C++ when the subscription state of a proxy event changes. The stored closure has
+/// the signature `FnMut(u8) -> bool` (raw `SubscriptionState`); the returned `bool` tells the
+/// middleware whether the handler shall be kept (`true`) or unregistered (`false`).
+///
+/// # Safety
+/// - `ptr` must point to a valid `FatPtr` whose payload is a live
+///   `Box<dyn FnMut(u8) -> bool + Send + 'static>` that has not yet been dropped.
+/// - `new_state` must be one of the raw `SubscriptionState` enumeration values.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn mw_com_impl_call_dyn_ref_fnmut_subscription_state(ptr: *const FatPtr, new_state: u8) -> bool {
+    if ptr.is_null() {
+        return false;
+    }
+    // SAFETY: caller guarantees ptr is a valid FatPtr created from a
+    // Box<dyn FnMut(u8) -> bool + Send + 'static>; transmute reconstructs the fat pointer.
+    // The reconstructed trait-object type must match the boxing site
+    // (`consumer.rs`) and the typed deleter `mw_com_impl_delete_boxed_fnmut_subscription_state`,
+    // otherwise the allocation could be interpreted through a different (unspecified) vtable.
+    let callable: *mut (dyn FnMut(u8) -> bool + Send + 'static) = unsafe { std::mem::transmute(*ptr) };
+    // SAFETY: the box is still alive (C++ only disposes it after all invocations finish); the
+    // raw pointer is valid for the duration of this call.
+    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe { (*callable)(new_state) })) {
+        Ok(keep) => keep,
+        Err(_) => {
+            log::error!(
+                "Panic caught in mw_com_impl_call_dyn_ref_fnmut_subscription_state: aborting to prevent unwind across FFI boundary"
+            );
+            // Abort to prevent unwinding across FFI boundary
+            std::process::abort();
+        },
+    }
+}
+
+/// Drops a boxed `FnMut(u8) -> bool` subscription state change handler.
+///
+/// Called by C++ (`RustBoxedCallable<bool, SubscriptionState>::dispose`) when the handler is
+/// unregistered or overridden. It must use the same closure type that
+/// [`mw_com_impl_call_dyn_ref_fnmut_subscription_state`] expects so that the drop glue and
+/// allocation layout are reconstructed for the correct trait object type.
+///
+/// # Safety
+/// `ptr` must point to the same `FatPtr` that was previously passed to
+/// `mw_com_proxy_event_set_subscription_state_change_handler`, and must only be called once.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn mw_com_impl_delete_boxed_fnmut_subscription_state(ptr: *mut FatPtr) {
+    // SAFETY: caller guarantees ptr is valid and this is the single dispose call.
+    let dyn_fnmut: *mut (dyn FnMut(u8) -> bool + Send + 'static) = unsafe { std::mem::transmute(*ptr) };
+    drop(unsafe { Box::from_raw(dyn_fnmut) });
+}
+
