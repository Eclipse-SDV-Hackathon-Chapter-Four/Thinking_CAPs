+load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
+load("//score/mw/com/test:pkg_application.bzl", "pkg_application")
+
+# Single production binary with two roles chosen at runtime:
+#   * controller (default, --scenario <name>): owns the LoLa runtime, discovery,
+#     consumer and subscription; spawns itself as the provider child.
+#   * provider (--provider): owns a separate LoLa runtime and offered producer.
+rust_binary(
+    name = "subscription-state-apis",
+    srcs = ["subscription_state_app.rs"],
+    features = ["link_std_cpp_lib"],
+    # linux_x86_64_score_gcc_12_2_0_posix toolchain is built without --enable-default-pie, so its static C++ libs are non-PIC.
+    # When Bazel builds this binary in exec config (py_test build with rule cfg=exec), the Rust linker
+    # defaults to PIE and rejects non-PIC archives. -no-pie disables PIE; -lstdc++ is needed because
+    # the link_std_cpp_lib CC feature is not activated in exec config.
+    rustc_flags = select({
+        "@platforms//os:linux": [
+            "-Clink-arg=-no-pie",
+            "-Clink-arg=-lstdc++",
+        ],
+        "//conditions:default": [],
+    }),
+    visibility = [
+        "//score/mw/com/test/basic_rust_api:__subpackages__",
+    ],
+    deps = [
+        "//score/mw/com/rust:score_com",
+        "//score/mw/com/test/basic_rust_api:bigdata_com_api_gen_rs",
+    ],
+)
+
+rust_test(
+    name = "subscription-state-apis-tests",
+    crate = ":subscription-state-apis",
+    target_compatible_with = [
+        "@platforms//os:linux",
+        "@platforms//cpu:x86_64",
+    ],
+)
+
+pkg_application(
+    name = "subscription-state-apis-pkg",
+    app_name = "subscription-state-apis",
+    bin = [
+        ":subscription-state-apis",
+    ],
+    etc = [
+        "//score/mw/com/test/basic_rust_api/etc:config",
+        "//score/mw/com/test/bigdata:logging.json",
+    ],
+    visibility = [
+        "//score/mw/com/test/basic_rust_api:__subpackages__",
+    ],
+)
