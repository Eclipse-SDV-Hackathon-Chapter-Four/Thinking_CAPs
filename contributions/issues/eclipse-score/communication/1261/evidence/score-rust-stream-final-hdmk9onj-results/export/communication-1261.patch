+        NativeServiceIdentity {
+            name: name.to_string(),
+            major: 1,
+            minor: 0,
+            binding: BINDING_LOLA,
+            service_id: 42,
+            instance_id,
+        }
+    }
+
+    fn service_type(name: &str) -> NativeServiceType {
