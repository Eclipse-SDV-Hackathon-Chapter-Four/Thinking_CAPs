+/// Interface-independent identification of a service that is available in the system.
+///
+/// Unlike [`ConsumerDescriptor`], which is only reachable through an interface-scoped
+/// [`ServiceDiscovery`], a `ServiceDescriptor` can identify an offered service without naming
+/// the service interface at the call site. It therefore carries both the interface identity
+/// ([`Interface::INTERFACE_ID`]) and the instance identity ([`InstanceSpecifier`]). This is what
+/// allows a single system-wide stream ([`Runtime::find_all_services`]) to report services that
+/// belong to different interfaces.
+///
+/// # Open design questions (not decided by this type)
+/// The C++ service-discovery model additionally knows a binding-specific service id, instance
+/// id, version and a quality-of-service selector
+/// (`score/mw/com/design/service_discovery/README.md`). Whether those must also be part of this
+/// descriptor is an open engineering decision; they are intentionally not included until an
+/// authorized design decision requires them.
+#[derive(Clone, Debug)]
+pub struct ServiceDescriptor {
+    interface_id: &'static str,
+    instance_specifier: InstanceSpecifier,
+}
+
+impl ServiceDescriptor {
+    /// Creates a descriptor from a service interface identifier and an instance specifier.
+    ///
+    /// # Parameters
+    /// * `interface_id` - The [`Interface::INTERFACE_ID`] of the offered service.
+    /// * `instance_specifier` - The location of the offered service instance.
+    pub fn new(interface_id: &'static str, instance_specifier: InstanceSpecifier) -> Self {
+        Self {
+            interface_id,
+            instance_specifier,
+        }
+    }
+
+    /// Returns the unique identifier of the service interface ([`Interface::INTERFACE_ID`]).
+    pub fn interface_id(&self) -> &'static str {
+        self.interface_id
+    }
+
+    /// Returns the technology-independent location of the offered service instance.
+    pub fn instance_specifier(&self) -> &InstanceSpecifier {
+        &self.instance_specifier
+    }
+}
+
