+/// Version of a service interface as observed in the native configuration.
+///
+/// This mirrors the `major`/`minor` pair of the native `ServiceVersionType` and is part of the
+/// full interface identity carried by a [`ServiceDescriptor`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct ServiceVersion {
+    /// Major version of the service interface.
+    pub major: u32,
+    /// Minor version of the service interface.
+    pub minor: u32,
+}
+
+impl ServiceVersion {
+    /// Creates a version from its `major` and `minor` components.
+    pub fn new(major: u32, minor: u32) -> Self {
+        Self { major, minor }
+    }
+}
+
+impl core::fmt::Display for ServiceVersion {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "{}.{}", self.major, self.minor)
+    }
+}
+
+/// Interface-independent identification of a service instance that is available in the system.
+///
+/// Unlike [`ConsumerDescriptor`], which is only reachable through an interface-scoped
+/// [`ServiceDiscovery`], a `ServiceDescriptor` identifies an offered service without naming the
+/// service interface at the call site. This is what allows a single system-wide stream
+/// ([`Runtime::find_all_services`]) to report services that belong to different interfaces.
+///
+/// # Observed native identity
+/// Every field is an owned, concrete value observed from the native service discovery layer:
+/// the configured service type name, its full [`ServiceVersion`], the binding name, the
+/// binding-specific service id and the binding-specific instance id. There is deliberately no
+/// [`InstanceSpecifier`] here: a FindAny/wildcard result is identified by the native instance id
+/// and not by a consumer-configured specifier, and inventing a specifier for such a result would
+/// be incorrect.
+///
+/// # Open design questions (not decided by this type)
+/// Whether a quality-of-service selector must also be part of this descriptor is an open
+/// engineering decision; it is intentionally not included until an authorized design decision
+/// requires it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ServiceDescriptor {
+    service_type_name: String,
+    version: ServiceVersion,
+    binding: String,
+    service_id: u32,
+    instance_id: u32,
+}
+
+impl ServiceDescriptor {
+    /// Creates a descriptor from the observed native service instance identity.
+    ///
+    /// # Parameters
+    /// * `service_type_name` - The configured service type name of the offered service.
+    /// * `version` - The full [`ServiceVersion`] of the offered service.
+    /// * `binding` - The binding name (e.g. `"lola"`).
+    /// * `service_id` - The binding-specific service id.
+    /// * `instance_id` - The binding-specific instance id observed for this instance.
+    pub fn new(
+        service_type_name: impl Into<String>,
+        version: ServiceVersion,
+        binding: impl Into<String>,
+        service_id: u32,
+        instance_id: u32,
+    ) -> Self {
+        Self {
+            service_type_name: service_type_name.into(),
+            version,
+            binding: binding.into(),
+            service_id,
+            instance_id,
+        }
+    }
+
+    /// Returns the configured service type name of the interface this service belongs to.
+    pub fn service_type_name(&self) -> &str {
+        &self.service_type_name
+    }
+
+    /// Returns the full version of the service interface.
+    pub fn version(&self) -> ServiceVersion {
+        self.version
+    }
+
+    /// Returns the binding name of the offered service.
+    pub fn binding(&self) -> &str {
+        &self.binding
+    }
+
+    /// Returns the binding-specific service id.
+    pub fn service_id(&self) -> u32 {
+        self.service_id
+    }
+
+    /// Returns the binding-specific instance id observed for this instance.
+    pub fn instance_id(&self) -> u32 {
+        self.instance_id
+    }
+}
