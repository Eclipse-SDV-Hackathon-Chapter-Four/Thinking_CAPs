+/// Offers two instances of `BigDataInterface` and one `ComplexStructInterface` instance.
+///
+/// Only the first BigData instance is present in the consumer configuration; the second one and
+/// the ComplexStruct instance are offered exclusively from this provider manifest. This makes the
+/// consumer's typed find-any query discriminating: a genuine native wildcard must return both
+/// BigData instances (including the one absent from the consumer configuration) and must exclude
+/// the offered ComplexStruct instance.
+fn run_find_any_test<R: Runtime>(runtime: &R, num_cycles: u32) {
+    println!(
+        "[find-any-producer] Starting find_any test with num_cycles={}",
+        num_cycles
+    );
+
+    let first_specifier =
+        InstanceSpecifier::new("/score/cp60/MapApiLanesStamped").expect("Invalid instance specifier");
+    let second_specifier =
+        InstanceSpecifier::new("/score/cp60/MapApiLanesStampedSecond").expect("Invalid instance specifier");
+    let complex_specifier =
+        InstanceSpecifier::new("/UserDefinedTest/ComplexStruct").expect("Invalid instance specifier");
+
+    // Sleep to allow the consumer to start first and observe the empty state before any offer.
+    thread::sleep(SERVICE_OFFER_DELAY_MS);
+
+    let first_offered = runtime
+        .producer_builder::<BigDataInterface>(first_specifier)
+        .build()
+        .expect("Failed to build first BigData producer")
+        .offer()
+        .expect("Failed to offer first BigData service");
+    // Kept alive for the whole test so the second same-interface instance stays offered.
+    let second_offered = runtime
+        .producer_builder::<BigDataInterface>(second_specifier)
+        .build()
+        .expect("Failed to build second BigData producer")
+        .offer()
+        .expect("Failed to offer second BigData service");
+    // A different interface offered concurrently, so the consumer can prove exclusion.
+    let _complex_offered = runtime
+        .producer_builder::<ComplexStructInterface>(complex_specifier)
+        .build()
+        .expect("Failed to build ComplexStruct producer")
+        .offer()
