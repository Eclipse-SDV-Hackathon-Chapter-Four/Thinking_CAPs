  "runs": [
    {
      "results": [
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "score/memory/shared/fake/my_bounded_memory_resource.cpp",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startColumn": 50,
                  "startLine": 37
                }
              }
            }
          ],
          "message": {
            "text": "do not use pointer arithmetic [cppcoreguidelines-pro-bounds-pointer-arithmetic]"
          }
        }
      ],
      "tool": {
        "driver": {
          "name": "ClangTidy"
        }
      }
    }
  ],
  "version": "2.1.0"
}
