{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "clippy",
          "informationUri": "https://rust-lang.github.io/rust-clippy/",
          "rules": [
            {
              "id": "clippy::result_unit_err",
              "fullDescription": {
                "text": "use a custom `Error` type instead\nfor further information visit https://rust-lang.github.io/rust-clippy/master/index.html#result_unit_err\n`#[warn(clippy::result_unit_err)]` on by default\n"
              },
              "helpUri": "https://rust-lang.github.io/rust-clippy/master/index.html#result_unit_err"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "clippy::result_unit_err",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "this returns a `Result<_, ()>`"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "score/mw/com/impl/rust/com-api/com-api-ffi-lola/bridge_ffi.rs"
                },
                "region": {
                  "byteOffset": 12772,
                  "byteLength": 92,
                  "startLine": 262,
                  "startColumn": 5,
                  "endLine": 262,
                  "endColumn": 97
                }
              }
            }
          ],
          "relatedLocations": []
        }
      ]
    }
  ]
}