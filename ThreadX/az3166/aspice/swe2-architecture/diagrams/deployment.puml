@startuml deployment
!theme plain
skinparam defaultFontName "DejaVu Sans"
title Deployment view
skinparam shadowing false
node "Host PC (Linux)" as PC {
  artifact "bridge.py\n+ bridge-az3166.json" as BR
  artifact "python-can slcan\n+ pyserial" as PY
  interface "/dev/serial/by-id/\n...STLink...-if02" as TTY
}
node "MXChip AZ3166" as BOARD {
  node "ST-LINK/V2-1" as STL {
    component "USB CDC (VCP)" as VCP
    component "USB mass storage\n(drag-and-drop flash)" as MSD
  }
  node "STM32F412RG\nCortex-M4 @ 96 MHz (HSI)\n1 MiB flash / 256 KiB RAM" as MCU {
    artifact "threadx-zonal-lights-az3166.bin\n(~16.5 KB)" as FW
    component "USART6 PA11/PA12" as U6
    component "GPIO: PB4 red, PC13 user,\nPA15 Azure, PB2 Wi-Fi, PC7 blue" as GPIO
    component "I2C1 PB8/PB9 → SSD1306 OLED" as I2C
  }
}
BR --> PY
PY --> TTY
TTY --> VCP : USB
VCP --> U6 : UART 115200 8N1
MSD ..> FW : programs flash
FW --> U6
FW --> GPIO
FW --> I2C
@enduml
