@startuml tasks
!theme plain
skinparam defaultFontName "DejaVu Sans"
title Dynamic view — ThreadX resources, priorities and data flow
skinparam shadowing false
left to right direction

rectangle "USART6 IRQ\n(priority 0x80)" as ISR #FBEDEA
rectangle "SysTick 100 Hz\n(priority 0x40)" as TICK #FBEDEA
queue "rx_byte_queue\n256 × 1 word" as Q1
queue "frame_queue\n32 × 4 words" as Q2
rectangle "ingress_thread\nprio 11, 2 KiB" as ING #E8F1FB
rectangle "control_thread\nprio 10, 2 KiB" as CTL #E8F1FB
rectangle "display_thread\nprio 20, 2 KiB" as DSP #E8F1FB
rectangle "heartbeat_timer\n1 s periodic" as TMR
collections "events\nHEARTBEAT | LINK" as EV
collections "display_events\nREDRAW" as DEV
rectangle "uart_lock (mutex, inherit)" as M1
rectangle "status_lock (mutex, inherit)" as M2
rectangle "TX ring 1 KiB\n(TXE interrupt)" as RING

ISR --> Q1 : tx_queue_send(TX_NO_WAIT)
Q1 --> ING : receive (wait forever)
ING --> Q2 : accepted 0x1F1 (TX_NO_WAIT)
Q2 --> CTL : receive (1 tick)
TICK --> TMR
TMR --> EV : HEARTBEAT
ING --> EV : LINK
EV --> CTL
CTL --> DEV : REDRAW
ING --> DEV : REDRAW
DEV --> DSP
ING --> M1
CTL --> M1
M1 --> RING
RING --> ISR : drained by TXE
CTL --> M2
DSP --> M2
@enduml
