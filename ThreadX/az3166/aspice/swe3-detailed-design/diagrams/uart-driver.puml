@startuml uart-driver
!theme plain
skinparam defaultFontName "DejaVu Sans"
title DD-04 USART6 driver — ISR and TX ring
skinparam shadowing false
|USART6_IRQHandler|
start
:status = SR;
if (RXNE or ORE?) then (yes)
  :byte = DR (clears ORE);
  if (ORE?) then (yes)
    :overruns++;
  endif
  if (RXNE?) then (yes)
    :rx_callback(byte)\n→ tx_queue_send(NO_WAIT) or rx_overflow++;
  endif
endif
if (TXEIE and TXE?) then (yes)
  if (ring empty?) then (yes)
    :disable TXEIE;
  else (no)
    :DR = ring[tail++];
  endif
endif
stop
|board_uart_write (thread, under uart_lock)|
start
if (free space >= length?) then (no)
  :return false (caller retries, max 0.5 s);
  stop
endif
:copy line into ring; DMB; head = new;
:IRQ off; TXEIE on; IRQ restore;
:return true;
stop
@enduml
