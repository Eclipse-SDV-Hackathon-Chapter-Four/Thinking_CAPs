{
  "zenoh": {
    "mode": "client",
    "connect": [
      "tcp/127.0.0.1:40533"
    ]
  },
  "publish_aggregate": true,
  "can_buses": [
    {
      "name": "zonal",
      "interface": "/dev/ttyACM1",
      "bus_type": "slcan",
      "bitrate": 500000
    }
  ],
  "can_forwarding": {
    "enabled": false
  },
  "mappings": [
    {
      "name": "VCU status to zonal controller",
      "zenoh_key": "vcu/control/status",
      "direction": "zenoh_to_can",
      "tx_buses": [
        "zonal"
      ],
      "can_message": {
        "id": "0x1F1",
        "dlc": 8
      },
      "signals": [
        {
          "name": "vcu_cc_engage_sts",
          "zenoh_key": "vcu/control/cc_engage_sts",
          "start_bit": 0,
          "length": 1,
          "byte_order": "little_endian",
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "type": "bool"
        },
        {
          "name": "vcu_reverse_sts",
          "zenoh_key": "vcu/control/reverse_sts",
          "start_bit": 1,
          "length": 1,
          "byte_order": "little_endian",
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "type": "bool"
        },
        {
          "name": "vcu_brake_sts",
          "zenoh_key": "vcu/control/brake_sts",
          "start_bit": 2,
          "length": 1,
          "byte_order": "little_endian",
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "type": "bool"
        }
      ]
    },
    {
      "name": "ThreadX lights to vehicle",
      "zenoh_key": "vehicle/lights/frame",
      "direction": "can_to_zenoh",
      "rx_buses": [
        "zonal"
      ],
      "can_message": {
        "id": "0x1F4",
        "dlc": 8
      },
      "signals": [
        {
          "name": "bcm_reverse_lights_cmd",
          "zenoh_key": "vehicle/lights/reverse_lights_cmd",
          "start_bit": 0,
          "length": 1,
          "byte_order": "little_endian",
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "type": "bool"
        },
        {
          "name": "bcm_brake_lights_cmd",
          "zenoh_key": "vehicle/lights/brake_lights_cmd",
          "start_bit": 1,
          "length": 1,
          "byte_order": "little_endian",
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "type": "bool"
        }
      ]
    }
  ]
}
