    url: git@github.com:The-Xverse/carla-simulator-bridge.git
    version: dev/etas_s-core
  bridges/ros2:
    type: git
    url: git@github.com:The-Xverse/zenoh2ros2_bridge.git
    version: main
  bridges/can:
    type: git
    url: git@github.com:The-Xverse/zenoh2can_bridge.git
    version: main
  bridges/someip:
    type: git
    url: git@github.com:The-Xverse/zenoh2someip_bridge.git
    version: dev/etas_s-core
  # core
  core/zenoh:
    type: git
    url: git@github.com:The-Xverse/zenoh-core.git
    version: main
  # BCM-Zephir
  core/BCM:
    type: git
    url: git@github.com:The-Xverse/Zephyr-BCM.git
    version: main
  # vECUs
  vecu/simulink:
    type: git
    url: git@github.com:The-Xverse/simulink-vecu.git
    version: dev/bmw-demo
  vecu/s-core:
    type: git
    url: git@github.com:The-Xverse/adas_s-core.git
    version: dev/bmw-demo
  vecu/vcu_can:
    type: git
    url: git@github.com:The-Xverse/FreeRTOS-vECU.git
    version: main
  vecu/vcu_zenoh:
    type: git
    url: git@github.com:The-Xverse/vcu-zenoh-python.git
    version: main
  vecu/bcm_can:
    type: git
    url: git@github.com:The-Xverse/zephyr-vecu.git
    version: main
