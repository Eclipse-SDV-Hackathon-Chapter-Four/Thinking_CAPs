@startuml link-state
!theme plain
skinparam defaultFontName "DejaVu Sans"
title Behaviour — SLCAN link and lamp state
skinparam shadowing false
[*] --> Closed : reset\nlamps off
state Closed {
  Closed : lamps off
  Closed : frames → BELL
  Closed : S/Z accepted
}
state Open {
  [*] --> Holding : report current 0x1F4
  Holding : lamps = last command
  Holding --> Holding : valid 0x1F1 / apply + emit 0x1F4
  Holding --> Holding : other frame / ack, rejected++
  Holding --> Stale : timeout (ZONAL_TIMEOUT_MS > 0)
  Stale : lamps off, stale flag
  Stale --> Holding : valid 0x1F1
  Open : 1 s heartbeat 0x1F5
}
Closed --> Open : "O" / ack, Azure LED on
Open --> Closed : "C" / ack, lamps off, Azure LED off
Closed --> Fault : ThreadX error / stack overflow / CPU fault
Open --> Fault : ThreadX error / stack overflow / CPU fault
state Fault #FBEDEA : lamps off, RGB blue, halt
@enduml
