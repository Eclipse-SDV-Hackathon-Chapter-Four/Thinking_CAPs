@startuml control-loop
!theme plain
skinparam defaultFontName "DejaVu Sans"
title DD-09 control_entry() — lighting control thread cycle
skinparam shadowing false
start
:lights_off(output); apply(lamps off);
repeat
  :tx_queue_receive(frame_queue, 1 tick);
  if (frame received and link open and lights_decode ok?) then (yes)
    :last_valid = now; stale = false; received++;
    :apply(output) → board_lamps + status snapshot + REDRAW;
    :publish(0x1F4);
  endif
  if (timeout enabled and now - last_valid >= timeout and not stale?) then (yes)
    :stale = true; lights_off; apply; publish(0x1F4);
  endif
  if (LINK event?) then (yes)
    if (link open?) then (no)
      :lights_off; apply (fail-safe);
    endif
    :publish current 0x1F4 (only if open);
  endif
  if (HEARTBEAT event?) then (yes)
    :toggle Wi-Fi LED;
    :publish 0x1F5 diagnostics;
    :REDRAW;
  endif
repeat while (forever)
@enduml
