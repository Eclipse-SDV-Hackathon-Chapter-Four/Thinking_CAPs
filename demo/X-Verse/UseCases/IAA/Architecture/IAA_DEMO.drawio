        <mxCell id="voruR38qudZa-LJa6zvy-181" value="&lt;h1 style=&quot;margin-top: 0px; font-size: 23px;&quot;&gt;USE CASES&lt;/h1&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&lt;b&gt;- RPM ( from Carla )&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&lt;b&gt;- SPEED ( from Carla )&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&lt;b&gt;- CRUISE CONTROL&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&amp;nbsp;-- Enabler by IPC (Volante or IVI)&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&amp;nbsp;-- CC Speed Default&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&lt;b&gt;- EMERGENCE BRAKE&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&amp;nbsp;-- Stop the Vehicle&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&amp;nbsp;-- Send event to AAOS&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&lt;b&gt;- LANE DEPARTURE&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&amp;nbsp;-- Send event to AAOS&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&lt;b&gt;&amp;nbsp;- CUSTOMIZATION&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&amp;nbsp;-- Send color to Vehicle CARLA&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&lt;b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;NICE TO HAVE&lt;/span&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 23px;&quot;&gt;&lt;b&gt;&amp;nbsp;-- Send Actors ( Objects from CARLA to AAOS with relative position, e.g. Pedestrian, Vehicle, Semaphore)&lt;/b&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=23;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
